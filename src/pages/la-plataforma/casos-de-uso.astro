---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/components-astro/Badge.astro";
import Button from "../../components/components-astro/Button.astro";
import TextReveal from "../../components/components-astro/TextReveal.astro";
import {
    FiBookOpen,
    FiUsers,
    FiClipboard,
    FiGlobe,
    FiArrowRight,
    FiCheck,
    FiDownload,
    FiDatabase,
    FiWifiOff,
    FiRefreshCw,
    FiMapPin,
    FiCamera,
    FiTrendingUp,
    FiTerminal,
} from "react-icons/fi";
---

<Layout
    title="Casos de Uso"
    description="Descubre las aplicaciones prácticas, casos de estudio y ejemplos de implementación de DATAUMSA en la academia y la investigación."
>
    <div class="w-full flex flex-col items-center">
        <!-- Hero Section (Main Canvas) -->
        <section class="w-full py-16 md:py-24 bg-canvas">
            <div class="max-w-300 mx-auto px-4 sm:px-6 flex flex-col items-center text-center">
                <Badge variant="primary" class="mb-5">
                    Flexibilidad y Aplicación
                </Badge>
                <h1 class="text-ink font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] leading-[1.08] max-w-4xl mb-6">
                    ¿Para qué puedes usar <br class="hidden md:block" />
                    <TextReveal variant="light">DATAUMSA?</TextReveal>
                </h1>
                <p class="text-text-muted font-sans text-base sm:text-lg md:text-xl max-w-2xl font-medium leading-relaxed">
                    De la recolección de tesis individuales a censos
                    poblacionales de gran escala. Conoce los escenarios donde
                    nuestra infraestructura marca la diferencia.
                </p>
            </div>
        </section>

        <!-- CASO 1: INVESTIGACIÓN Y TESIS (Main Canvas) -->
        <section
            id="tesis"
            class="w-full py-16 lg:py-20 bg-canvas scroll-mt-20 border-t-[2.5px] border-ink"
        >
            <div class="max-w-300 mx-auto px-4 sm:px-6 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
                <!-- Columna de Texto -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="w-12 h-12 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center text-ink">
                            <FiBookOpen className="w-6 h-6" strokeWidth={2.5} />
                        </div>
                        <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-ink font-mono bg-white border border-ink">
                            Caso de Uso 01
                        </span>
                    </div>

                    <h2 class="text-ink font-display text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight mb-5">
                        Investigación Científica y Tesis de Grado
                    </h2>

                    <div class="text-text-muted font-sans text-base sm:text-lg leading-relaxed space-y-5 mb-8 font-medium">
                        <p>
                            La investigación académica rigurosa exige precisión
                            metodológica, consistencia en los datos y el
                            cumplimiento de altos estándares éticos. DATAUMSA
                            proporciona a tesistas de pregrado, posgrado e
                            investigadores una infraestructura robusta para
                            recolectar datos sin sesgo corporativo.
                        </p>
                        <p>
                            Mediante el estándar{" "}
                            <strong class="text-ink font-bold">XLSForm</strong>,
                            puedes programar validaciones lógicas avanzadas en
                            el celular (por ejemplo, rangos realistas de medidas
                            y cálculo de IMC al instante), reduciendo la tasa de
                            error en la captura inicial.
                        </p>

                        <!-- Puntos clave con Checks -->
                        <ul class="space-y-3 pt-2">
                            <li class="flex items-start gap-3">
                                <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full border border-ink flex items-center justify-center bg-success text-ink">
                                    <FiCheck
                                        className="w-3.5 h-3.5 text-ink"
                                        strokeWidth={3.5}
                                    />
                                </div>
                                <span class="text-ink text-sm font-medium">
                                    <strong class="font-bold">
                                        Soberanía de datos:
                                    </strong>{" "}
                                    Información guardada localmente bajo
                                    estricta normativa de la UMSA.
                                </span>
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full border border-ink flex items-center justify-center bg-success text-ink">
                                    <FiCheck
                                        className="w-3.5 h-3.5 text-ink"
                                        strokeWidth={3.5}
                                    />
                                </div>
                                <span class="text-ink text-sm font-medium">
                                    <strong class="font-bold">
                                        Interoperabilidad Directa:
                                    </strong>{" "}
                                    Exportación nativa a SPSS (`.sav`), Stata
                                    (`.dta`), R y Excel.
                                </span>
                            </li>
                        </ul>
                    </div>

                    <!-- Caja de Ejemplo Práctico Bento -->
                    <div class="bg-white border-2 border-ink rounded-3xl p-6 mb-8">
                        <span class="block text-xs font-bold uppercase tracking-wider text-primary-dark mb-2 font-mono">
                            Ejemplo Práctico en la UMSA
                        </span>
                        <p class="text-ink text-sm font-medium leading-relaxed">
                            <strong>Tesis de la Facultad de Medicina:</strong>{" "}
                            Evaluación nutricional en comunidades del Altiplano.
                            El tesista programa saltos condicionales
                            automáticos: si el resultado calcula desnutrición
                            severa, se exige coordenada GPS y fotografía de la
                            vivienda para coordinar asistencia.
                        </p>
                    </div>

                    <div>
                        <Button
                            href="/la-plataforma/caracteristicas"
                            variant="bento-primary"
                            class="text-sm py-3 px-6"
                        >
                            <span>Ver características completas</span>
                            <FiArrowRight className="w-4 h-4 ml-1" />
                        </Button>
                    </div>
                </div>

                <!-- Columna de Ilustración Bento (Dashboard de Datos) -->
                <div class="w-full lg:w-1/2 flex items-center justify-center">
                    <div class="w-full max-w-125 rounded-card border-[2.5px] border-ink bg-white p-6 relative overflow-hidden flex flex-col justify-between">
                        <!-- Top Bar del Mockup -->
                        <div class="flex justify-between items-center border-b-2 border-ink pb-4 mb-4">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full bg-danger border border-ink"></div>
                                <div class="w-3 h-3 rounded-full bg-warning border border-ink"></div>
                                <div class="w-3 h-3 rounded-full bg-success border border-ink"></div>
                                <span class="text-xs font-mono font-bold text-text-muted ml-2">
                                    data_analysis_spss.sav
                                </span>
                            </div>
                            <div>
                                <span class="px-2.5 py-1 text-xs font-mono font-bold uppercase tracking-wider rounded-full bg-success text-ink border border-ink flex items-center gap-1">
                                    <FiDatabase className="w-3 h-3" /> Validado
                                </span>
                            </div>
                        </div>

                        <!-- Gráfico de Barras Bento -->
                        <div class="grow flex flex-col justify-end gap-6 mb-6">
                            <div class="flex justify-around items-end h-36 px-4 border-b-2 border-ink pb-2 relative bg-canvas rounded-xl border border-ink/20 pt-6">
                                <!-- Barra 1 -->
                                <div class="w-14 flex flex-col items-center gap-2">
                                    <div class="w-full bg-primary border-2 border-ink rounded-t-lg h-24 hover:h-28 transition-all duration-300"></div>
                                    <span class="text-xs font-mono text-ink font-bold">
                                        Muestra A
                                    </span>
                                </div>
                                <!-- Barra 2 -->
                                <div class="w-14 flex flex-col items-center gap-2">
                                    <div class="w-full bg-accent border-2 border-ink rounded-t-lg h-16 hover:h-20 transition-all duration-300"></div>
                                    <span class="text-xs font-mono text-ink font-bold">
                                        Muestra B
                                    </span>
                                </div>
                                <!-- Barra 3 -->
                                <div class="w-14 flex flex-col items-center gap-2">
                                    <div class="w-full bg-success border-2 border-ink rounded-t-lg h-28 hover:h-32 transition-all duration-300"></div>
                                    <span class="text-xs font-mono text-ink font-bold">
                                        Muestra C
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Footer con Botones de Exportación Sticker -->
                        <div class="flex flex-wrap gap-2 pt-4 border-t-2 border-ink items-center">
                            <span class="text-xs font-bold text-ink font-mono mr-1 uppercase">
                                Exportar:
                            </span>
                            <div class="px-3 py-1.5 rounded-full bg-canvas border-2 border-ink text-ink text-xs font-bold flex items-center gap-1.5 hover:-translate-y-0.5 transition-transform">
                                <FiDownload className="w-3.5 h-3.5 text-primary" />{" "}
                                SPSS (.sav)
                            </div>
                            <div class="px-3 py-1.5 rounded-full bg-canvas border-2 border-ink text-ink text-xs font-bold flex items-center gap-1.5 hover:-translate-y-0.5 transition-transform">
                                <FiDownload className="w-3.5 h-3.5 text-accent" />{" "}
                                Stata (.dta)
                            </div>
                            <div class="px-3 py-1.5 rounded-full bg-canvas border-2 border-ink text-ink text-xs font-bold flex items-center gap-1.5 hover:-translate-y-0.5 transition-transform">
                                <FiDownload className="w-3.5 h-3.5 text-success" />{" "}
                                Excel (.xlsx)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CASO 2: DOCENCIA Y PRÁCTICAS DE CAMPO (Cyan Light Band) -->
        <section
            id="docencia"
            class="w-full py-16 lg:py-20 bg-primary-light scroll-mt-20 border-y-[2.5px] border-ink"
        >
            <div class="max-w-300 mx-auto px-4 sm:px-6 flex flex-col-reverse lg:flex-row items-center gap-12 lg:gap-16">
                <!-- Mockup Celular Offline Bento -->
                <div class="w-full lg:w-1/2 flex items-center justify-center">
                    <div class="w-full max-w-100 rounded-[2.5rem] border-3 border-ink bg-white p-6 relative overflow-hidden flex flex-col justify-between">
                        <!-- Notch del Teléfono -->
                        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-5 bg-ink rounded-b-xl z-20 flex items-center justify-center">
                            <div class="w-10 h-1 bg-white/40 rounded-full mb-0.5"></div>
                        </div>

                        <!-- Cabecera de la App -->
                        <div class="pt-3 flex justify-between items-center border-b-2 border-ink pb-4">
                            <div class="flex flex-col">
                                <span class="text-sm font-extrabold text-ink font-display">
                                    DATAUMSA Collect
                                </span>
                                <span class="text-xs text-text-muted font-medium">
                                    Proyecto: Geología Aplicada
                                </span>
                            </div>
                            <div class="flex items-center gap-1 bg-warning border border-ink text-ink px-2.5 py-0.5 rounded-full text-xs font-bold">
                                <FiWifiOff className="w-3 h-3" /> Offline
                            </div>
                        </div>

                        <!-- Campos del Formulario Móvil -->
                        <div class="py-4 flex flex-col gap-3.5">
                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-bold uppercase tracking-wider text-text-muted font-mono">
                                    1. Formación rocosa
                                </label>
                                <input
                                    type="text"
                                    value="Caliza con fósiles marinos"
                                    disabled
                                    class="w-full px-3 py-2 bg-canvas border-2 border-ink rounded-xl text-xs font-bold text-ink"
                                />
                            </div>

                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-bold uppercase tracking-wider text-text-muted font-mono">
                                    2. Coordenadas GPS
                                </label>
                                <div class="flex gap-2 items-center px-3 py-2 bg-primary-light border-2 border-ink rounded-xl">
                                    <FiMapPin className="w-4 h-4 text-primary shrink-0" />
                                    <span class="text-xs font-mono text-ink font-bold">
                                        16.5001º S, 68.1500º W
                                    </span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-1">
                                <label class="text-xs font-bold uppercase tracking-wider text-text-muted font-mono">
                                    3. Foto de Campo
                                </label>
                                <div class="w-full h-20 rounded-xl bg-canvas border-2 border-ink flex items-center justify-center relative overflow-hidden">
                                    <div class="flex items-center gap-2 text-xs font-bold text-ink">
                                        <div class="w-8 h-8 rounded-lg bg-primary border border-ink flex items-center justify-center">
                                            <FiCamera className="w-4 h-4 text-ink" />
                                        </div>
                                        <span>muestra_estrato_1.jpg</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botón Sincronizar Sticker -->
                        <div class="pt-3 border-t-2 border-ink flex flex-col gap-1.5">
                            <div class="w-full bg-primary border-2 border-ink text-ink rounded-full py-2.5 px-4 flex items-center justify-between font-bold text-xs uppercase tracking-wider hover:-translate-y-0.5 active:translate-y-0.5 transition-transform cursor-pointer">
                                <span>Sincronizar Datos</span>
                                <FiRefreshCw className="w-4 h-4" />
                            </div>
                            <span class="text-[11px] text-center text-text-muted font-medium">
                                3 registros listos para enviar al servidor UMSA
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Columna de Texto -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="w-12 h-12 rounded-2xl bg-white border-2 border-ink flex items-center justify-center text-ink">
                            <FiUsers className="w-6 h-6" strokeWidth={2.5} />
                        </div>
                        <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-ink font-mono bg-white border border-ink">
                            Caso de Uso 02
                        </span>
                    </div>

                    <h2 class="text-ink font-display text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight mb-5">
                        Docencia y Prácticas de Campo
                    </h2>

                    <div class="text-text-muted font-sans text-base sm:text-lg leading-relaxed space-y-5 mb-8 font-medium">
                        <p>
                            La formación académica en carreras como Geografía,
                            Agronomía, Medicina Social, Geología y Arqueología
                            requiere recolectar datos fuera del aula. DATAUMSA
                            simplifica el trabajo de los estudiantes,
                            estructurando la recolección grupal sin costo
                            alguno.
                        </p>
                        <p>
                            Los estudiantes no necesitan disponer de plan de
                            datos móviles. La app dedicada para Android almacena
                            de forma segura las respuestas en el teléfono de
                            forma cifrada. Al retornar a los campus con red
                            Wi-Fi, la sincronización se realiza en segundos.
                        </p>

                        <ul class="space-y-3 pt-2">
                            <li class="flex items-start gap-3">
                                <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full border border-ink flex items-center justify-center bg-success text-ink">
                                    <FiCheck
                                        className="w-3.5 h-3.5 text-ink"
                                        strokeWidth={3.5}
                                    />
                                </div>
                                <span class="text-ink text-sm font-medium">
                                    <strong class="font-bold">
                                        Captura Multimedia:
                                    </strong>{" "}
                                    Fotos, audios, firmas digitales y GPS
                                    satelital integrados.
                                </span>
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full border border-ink flex items-center justify-center bg-success text-ink">
                                    <FiCheck
                                        className="w-3.5 h-3.5 text-ink"
                                        strokeWidth={3.5}
                                    />
                                </div>
                                <span class="text-ink text-sm font-medium">
                                    <strong class="font-bold">
                                        Control Docente:
                                    </strong>{" "}
                                    Asignación de formularios por brigadas y
                                    seguimiento unificado de avance.
                                </span>
                            </li>
                        </ul>
                    </div>

                    <!-- Caja de Ejemplo Práctico -->
                    <div class="bg-white border-2 border-ink rounded-3xl p-6 mb-8">
                        <span class="block text-xs font-bold uppercase tracking-wider text-primary-dark mb-2 font-mono">
                            Ejemplo Práctico en la UMSA
                        </span>
                        <p class="text-ink text-sm font-medium leading-relaxed">
                            <strong>Práctica de la Carrera de Geología:</strong>{" "}
                            Mapeo sísmico en las laderas de La Paz. Los
                            estudiantes levantan muestras y coordenadas del
                            terreno sin cobertura. Al retornar, sincronizan y el
                            docente visualiza todas las muestras sobre un mapa
                            unificado.
                        </p>
                    </div>

                    <div>
                        <Button
                            href="/la-plataforma/comparativa"
                            variant="bento-primary"
                            class="text-sm py-3 px-6"
                        >
                            <span>Ver comparativa con otras herramientas</span>
                            <FiArrowRight className="w-4 h-4 ml-1" />
                        </Button>
                    </div>
                </div>
            </div>
        </section>

        <!-- CASO 3: OPERATIVOS CENSALES Y GRAN ESCALA (Midnight Band) -->
        <section
            id="censos"
            class="w-full py-16 lg:py-20 bg-midnight text-white scroll-mt-20 border-b-[2.5px] border-ink"
        >
            <div class="max-w-300 mx-auto px-4 sm:px-6 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
                <!-- Columna de Texto -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="w-12 h-12 rounded-2xl bg-midnight-surface border-2 border-ink flex items-center justify-center text-primary">
                            <FiClipboard
                                className="w-6 h-6"
                                strokeWidth={2.5}
                            />
                        </div>
                        <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-primary font-mono bg-midnight-surface border border-ink">
                            Caso de Uso 03
                        </span>
                    </div>

                    <h2 class="text-white font-display text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight mb-5">
                        Operativos Censales y Proyectos de Gran Escala
                    </h2>

                    <div class="text-text-dark-muted font-sans text-base sm:text-lg leading-relaxed space-y-5 mb-8 font-medium">
                        <p>
                            La planificación estratégica institucional exige
                            herramientas capaces de operar con presupuestos
                            optimizados y alta demanda. DATAUMSA demostró su
                            robustez combinando un modelo de autocenso digital
                            masivo para la comunidad y brigadas técnicas
                            compactas para relevamientos presenciales
                            estratégicos.
                        </p>
                        <p>
                            El sistema permite monitorizar los operativos
                            mediante dashboards en tiempo real: tasa de
                            respuesta por unidad académica, avance geolocalizado
                            de brigadas y auditoría de metadatos para garantizar
                            la rigurosidad del censo.
                        </p>

                        <ul class="space-y-3 pt-2">
                            <li class="flex items-start gap-3">
                                <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full border border-ink flex items-center justify-center bg-success text-ink">
                                    <FiCheck
                                        className="w-3.5 h-3.5 text-ink"
                                        strokeWidth={3.5}
                                    />
                                </div>
                                <span class="text-white text-sm font-medium">
                                    <strong class="font-bold text-primary">
                                        Alta Concurrencia y Autocenso:
                                    </strong>{" "}
                                    Soporte probado de miles de envíos
                                    simultáneos directos en el Datacenter UMSA.
                                </span>
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full border border-ink flex items-center justify-center bg-success text-ink">
                                    <FiCheck
                                        className="w-3.5 h-3.5 text-ink"
                                        strokeWidth={3.5}
                                    />
                                </div>
                                <span class="text-white text-sm font-medium">
                                    <strong class="font-bold text-primary">
                                        Auditoría y Validación Continua:
                                    </strong>{" "}
                                    Control de consistencia de respuestas y
                                    auditoría de metadatos de captura.
                                </span>
                            </li>
                        </ul>
                    </div>

                    <!-- Caja de Ejemplo Práctico Bento Dark -->
                    <div class="bg-midnight-surface border-2 border-ink rounded-3xl p-6 mb-8">
                        <span class="block text-xs font-bold uppercase tracking-wider text-primary mb-2 font-mono">
                            Ejemplo Práctico en la UMSA
                        </span>
                        <p class="text-white text-sm font-medium leading-relaxed">
                            <strong>Censo Universitario UMSA:</strong> Con un
                            presupuesto ajustado y una brigada técnica de solo{" "}
                            <strong class="text-primary font-bold">
                                30 censistas
                            </strong>
                            , DATAUMSA logró censar a{" "}
                            <strong class="text-primary font-bold">
                                más de 65.000 estudiantes
                            </strong>
                            , alcanzando un{" "}
                            <strong class="text-success font-bold">
                                95% de cobertura estudiantil mediante autocenso
                                digital directo
                            </strong>{" "}
                            sin intermediarios. La brigada presencial se
                            concentró en censar al 100% de las autoridades
                            facultativas, de carrera y departamentos, mientras
                            que para el estamento docente se implementó el
                            llenado virtual con brigadas de asistencia técnica a
                            solicitud.
                        </p>
                    </div>
                </div>

                <!-- Columna de Ilustración Bento (Dashboard Censo) -->
                <div class="w-full lg:w-1/2 flex items-center justify-center">
                    <div class="w-full max-w-125 rounded-card border-[2.5px] border-ink bg-midnight-surface p-6 relative overflow-hidden flex flex-col justify-between">
                        <!-- Top Bar del Monitoreo -->
                        <div class="flex justify-between items-center border-b-2 border-ink pb-4 mb-4">
                            <span class="text-xs font-extrabold text-white font-display tracking-tight">
                                Censo Universitario - Panel de Monitoreo
                            </span>
                            <div class="flex items-center gap-1.5 bg-midnight px-3 py-1 rounded-full border border-ink">
                                <span class="w-2 h-2 rounded-full bg-success"></span>
                                <span class="text-[11px] font-bold uppercase text-success font-mono">
                                    Servidores Activos
                                </span>
                            </div>
                        </div>

                        <!-- KPIs Bento -->
                        <div class="grid grid-cols-3 gap-3 mb-6">
                            <div class="bg-midnight border-2 border-ink p-3 rounded-2xl flex flex-col justify-center text-center">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-text-dark-muted mb-1 font-mono">
                                    Estudiantes
                                </span>
                                <span class="text-lg font-black text-white font-mono">
                                    +65.000
                                </span>
                            </div>
                            <div class="bg-midnight border-2 border-ink p-3 rounded-2xl flex flex-col justify-center text-center">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-text-dark-muted mb-1 font-mono">
                                    Censistas
                                </span>
                                <span class="text-lg font-black text-primary font-mono">
                                    30
                                </span>
                            </div>
                            <div class="bg-midnight border-2 border-ink p-3 rounded-2xl flex flex-col justify-center text-center">
