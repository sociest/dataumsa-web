---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/components-astro/Badge.astro";
import Button from "../../components/components-astro/Button.astro";
import TextReveal from "../../components/components-astro/TextReveal.astro";
import {
    FiLayers,
    FiSmartphone,
    FiBarChart2,
    FiShield,
    FiCheck,
    FiArrowRight,
} from "react-icons/fi";

const features = [
    {
        id: "formularios",
        title: "Diseño de Formularios",
        subtitle: "Arquitectura de datos sin límites.",
        icon: FiLayers,
        theme: "accent",
        bgCard: "bg-white",
        iconColor: "text-accent",
        tag: "XLSForm Avanzado",
        items: [
            "Lógica condicional avanzada",
            "Grupos repetibles",
            "Cálculos automáticos en tiempo real",
            "Soporte multimedia (fotos, audios, firmas)",
            "Preguntas georreferenciadas (GPS de alta precisión)",
        ],
    },
    {
        id: "offline",
        title: "Recolección Offline",
        subtitle: "Trabajo fluido en cualquier terreno.",
        icon: FiSmartphone,
        theme: "cyan",
        bgCard: "bg-primary-light",
        iconColor: "text-primary-dark",
        tag: "DATAUMSA Collect",
        items: [
            "App Android dedicada 100% desconectada",
            "Sincronización en bloque al recuperar red",
            "Cifrado local de formularios y respuestas",
            "Múltiples usuarios y asignación de brigadas",
        ],
    },
    {
        id: "analisis",
        title: "Gestión y Análisis",
        subtitle: "Data limpia lista para la academia.",
        icon: FiBarChart2,
        theme: "accent",
        bgCard: "bg-white",
        iconColor: "text-primary",
        tag: "Estadística y Ciencia de Datos",
        items: [
            "Dashboard de monitoreo en tiempo real",
            "Auditoría de tiempos de llenado y calidad",
            "Exportación directa (Excel, SPSS .sav, Stata .dta)",
            "API REST para integración con PowerBI y R",
        ],
    },
    {
        id: "seguridad",
        title: "Seguridad y Soberanía",
        subtitle: "Infraestructura bajo estricta custodia UMSA.",
        icon: FiShield,
        theme: "cyan",
        bgCard: "bg-primary-light",
        iconColor: "text-warning",
        tag: "Datacenter DTIC",
        items: [
            "Alojamiento 100% en servidores UMSA",
            "Control granular de accesos por roles",
            "Garantía de confidencialidad para investigaciones",
            "Cumplimiento de estándares de soberanía tecnológica",
        ],
    },
];
---

<Layout
    title="Características"
    description="Descubre las herramientas y capacidades avanzadas de DATAUMSA para investigación académica rigurosa."
>
    <section class="w-full py-16 md:py-24 bg-canvas">
        <div class="max-w-300 mx-auto px-4 sm:px-6 w-full flex flex-col lg:flex-row gap-12 lg:gap-16">
            <!-- Left: Sticky Sidebar con estilo Bento -->
            <div class="lg:w-5/12 lg:sticky lg:top-28 h-fit">
                <Badge variant="primary" class="mb-5">
                    Características
                </Badge>

                <h1 class="text-ink font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.08] tracking-[-0.035em] mb-6">
                    Herramientas avanzadas para <br class="hidden lg:block" />
                    <TextReveal variant="light">investigación real.</TextReveal>
                </h1>

                <p class="text-text-muted font-sans text-base sm:text-lg font-medium leading-relaxed mb-8">
                    Diseñado para operar en las condiciones más exigentes.
                    DATAUMSA te da el control total de tus datos, desde la
                    recolección en campo sin internet hasta la exportación
                    estadística directa.
                </p>

                <!-- Bento Mini Card en sidebar -->
                <div class="bg-white border-[2.5px] border-ink rounded-[1.75rem] p-6 hidden lg:flex flex-col gap-4">
                    <span class="text-xs font-mono font-bold uppercase tracking-wider text-text-muted">
                        Navegación Rápida
                    </span>
                    <div class="flex flex-col gap-2">
                        {features.map((feat) => (
                            <a
                                href={`#${feat.id}`}
                                class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-bold text-ink hover:bg-primary-light transition-colors border border-transparent hover:border-ink/30"
                            >
                                <span>{feat.title}</span>
                                <FiArrowRight className="w-4 h-4 text-primary" />
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            <!-- Right: Stack Vertical de Features Bento Cards -->
            <div class="lg:w-7/12 flex flex-col gap-8">
                {features.map((feat) => {
                    const Icon = feat.icon;
                    return (
                        <article
                            id={feat.id}
                            class={`${feat.bgCard} border-[2.5px] border-ink rounded-card p-7 sm:p-9 flex flex-col sm:flex-row gap-6 sm:gap-8 items-start hover:-translate-y-1 transition-transform duration-200 scroll-mt-28 group`}
                        >
                            <!-- Icono / Sticker Bento -->
                            <div class="shrink-0">
                                <div class="w-16 h-16 rounded-2xl border-2 border-ink bg-white flex items-center justify-center group-hover:bg-primary group-hover:scale-105 transition-all duration-200">
                                    <Icon
                                        class="w-8 h-8 text-ink"
                                        strokeWidth={2.5}
                                    />
                                </div>
                            </div>

                            <!-- Contenido principal -->
                            <div class="w-full">
                                <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
                                    <h3 class="text-ink font-display text-2xl font-extrabold tracking-tight">
                                        {feat.title}
                                    </h3>
                                    <span class="px-3 py-1 rounded-full text-xs font-bold font-mono uppercase bg-white border border-ink text-ink">
                                        {feat.tag}
                                    </span>
                                </div>

                                <p class="text-text-muted font-sans text-base mb-6 font-medium">
                                    {feat.subtitle}
                                </p>

                                <!-- Lista dividida en 2 columnas -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-3 pt-3 border-t-2 border-ink/15">
                                    {feat.items.map((item) => (
                                        <div class="flex items-start gap-2.5">
                                            <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full border border-ink bg-success text-ink flex items-center justify-center font-bold">
                                                <FiCheck
                                                    class="w-3 h-3 text-ink"
                                                    strokeWidth={3.5}
                                                />
                                            </div>
                                            <span class="text-ink font-sans font-medium text-sm leading-snug">
                                                {item}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </article>
                    );
                })}

                <!-- Bento CTA Banner al final de la página -->
                <div class="bg-midnight-surface border-[2.5px] border-ink rounded-card p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-6 mt-4">
                    <div class="space-y-2 text-center sm:text-left">
                        <h3 class="font-display font-extrabold text-2xl text-white tracking-tight">
                            ¿Listo para diseñar tu formulario?
                        </h3>
                        <p class="text-text-dark-muted text-sm font-sans font-medium">
                            Consulta la documentación paso a paso o accede con
                            tu cuenta institucional.
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-3 shrink-0">
                        <Button
                            href="/docs/guides/constructor-formularios"
                            variant="bento-primary"
                            class="text-sm py-3 px-5"
                        >
                            Ver Guías
                        </Button>
                        <Button
                            href="https://app-dataumsa.sociest.org/accounts/login/"
                            target="_blank"
                            variant="bento-secondary"
                            class="text-sm py-3 px-5"
                        >
                            Acceder
                        </Button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
