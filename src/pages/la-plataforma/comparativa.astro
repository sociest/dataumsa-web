---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/components-astro/Badge.astro";
import TextReveal from "../../components/components-astro/TextReveal.astro";
import Button from "../../components/components-astro/Button.astro";
import {
    FiShield,
    FiWifiOff,
    FiLayers,
    FiPieChart,
    FiDollarSign,
    FiX,
    FiMinus,
    FiCheck,
    FiCode,
    FiDatabase,
    FiMapPin,
    FiCamera,
    FiActivity,
    FiLock,
} from "react-icons/fi";

// Datos de la tabla comparativa
const features = [
    {
        aspect: "Privacidad y propiedad",
        icon: FiShield,
        google: { text: "Tus datos se monetizan", state: "danger" },
        umsa: { text: "100% bajo control UMSA", state: "success" },
    },
    {
        aspect: "Trabajo en campo",
        icon: FiWifiOff,
        google: { text: "Requiere conexión fija", state: "danger" },
        umsa: { text: "App nativa 100% offline", state: "success" },
    },
    {
        aspect: "Lógica de formularios",
        icon: FiLayers,
        google: { text: "Saltos lineales básicos", state: "warning" },
        umsa: { text: "XLSForm estándar avanzado", state: "success" },
    },
    {
        aspect: "Análisis científico",
        icon: FiPieChart,
        google: { text: "Limitado a Google Sheets", state: "danger" },
        umsa: { text: "R, Python, SPSS, Stata", state: "success" },
    },
    {
        aspect: "Funciones avanzadas",
        icon: FiDollarSign,
        google: { text: "Planes de pago restrictivos", state: "warning" },
        umsa: { text: "100% libre institucional", state: "success" },
    },
];
---

<Layout
    title="Comparativa"
    description="Descubre por qué DATAUMSA es la alternativa superior a Google Forms y herramientas comerciales para la investigación académica."
>
    <!-- 1. Hero & Tabla Comparativa (Main Canvas) -->
    <section class="w-full py-16 md:py-24 bg-canvas flex flex-col items-center">
        <div class="w-full max-w-300 mx-auto px-4 sm:px-6">
            <div class="flex flex-col items-center text-center mb-14">
                <Badge variant="primary" class="mb-5">
                    Análisis de Herramientas
                </Badge>
                <h1 class="text-ink font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] leading-[1.08] mb-5">
                    Más allá de las{" "}
                    <TextReveal variant="light">encuestas básicas</TextReveal>
                </h1>
                <p class="text-text-muted font-sans text-base sm:text-lg max-w-2xl font-medium leading-relaxed">
                    Por costumbre se han usado plataformas comerciales genéricas
                    para proyectos serios. Descubre por qué el rigor científico
                    exige una infraestructura universitaria especializada.
                </p>
            </div>

            <!-- Panel Contenedor Bento de la Tabla -->
            <div class="w-full overflow-x-auto rounded-card border-[2.5px] border-ink bg-white">
                <div class="min-w-190 w-full">
                    <!-- Header de la tabla -->
                    <div class="grid grid-cols-12 border-b-2 border-ink px-6 sm:px-8 py-5 items-center bg-canvas font-mono text-xs uppercase tracking-wider">
                        <div class="col-span-4 text-ink font-bold">
                            Característica Clave
                        </div>
                        <div class="col-span-4 pl-6 text-text-muted flex items-center justify-center gap-2 font-bold">
                            <span class="w-2.5 h-2.5 rounded-full bg-danger border border-ink"></span>{" "}
                            Alternativas Comerciales
                        </div>
                        <div class="col-span-4 pl-6 border-l-2 border-ink bg-primary-light py-3 -my-3 text-ink flex items-center justify-center gap-2 font-bold">
                            <span class="w-2.5 h-2.5 rounded-full bg-primary border border-ink"></span>{" "}
                            DATAUMSA
                        </div>
                    </div>

                    <!-- Filas de la tabla -->
                    <div class="divide-y-2 divide-ink/15">
                        {features.map((item) => {
                            const Icon = item.icon;
                            return (
                                <div class="grid grid-cols-12 px-6 sm:px-8 py-5 items-center hover:bg-slate-50 transition-colors">
                                    <!-- Aspecto -->
                                    <div class="col-span-4 flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl border border-ink bg-canvas flex items-center justify-center text-ink shrink-0">
                                            <Icon className="w-4 h-4" />
                                        </div>
                                        <span class="text-ink font-display font-bold text-sm sm:text-base leading-tight">
                                            {item.aspect}
                                        </span>
                                    </div>

                                    <!-- Alternativas Comerciales -->
                                    <div class="col-span-4 pl-6 flex justify-center">
                                        <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-text-muted font-sans">
                                            {item.google.state === "danger" && (
                                                <div class="w-5 h-5 rounded-full border border-ink bg-danger text-white flex items-center justify-center shrink-0">
                                                    <FiX
                                                        className="w-3.5 h-3.5"
                                                        strokeWidth={3}
                                                    />
                                                </div>
                                            )}
                                            {item.google.state ===
                                                "warning" && (
                                                <div class="w-5 h-5 rounded-full border border-ink bg-warning text-ink flex items-center justify-center shrink-0 font-bold">
                                                    <FiMinus
                                                        className="w-3.5 h-3.5"
                                                        strokeWidth={3}
                                                    />
                                                </div>
                                            )}
                                            <span>{item.google.text}</span>
                                        </div>
                                    </div>

                                    <!-- DATAUMSA -->
                                    <div class="col-span-4 pl-6 border-l-2 border-ink bg-primary-light/30 py-3 -my-3 flex items-center justify-center gap-2 text-xs sm:text-sm font-bold text-ink font-sans">
                                        <div class="w-5 h-5 rounded-full border border-ink bg-success text-ink flex items-center justify-center shrink-0">
                                            <FiCheck
                                                className="w-3.5 h-3.5"
                                                strokeWidth={3.5}
                                            />
                                        </div>
                                        <span>{item.umsa.text}</span>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Soberanía y Privacidad (Cyan Light Band) -->
    <section class="w-full py-16 lg:py-24 bg-primary-light border-y-[2.5px] border-ink">
        <div class="max-w-300 mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 items-center">
            <div>
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white border-2 border-ink text-ink mb-6">
                    <FiLock className="w-7 h-7" />
                </div>
                <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-ink mb-6 leading-tight tracking-tight">
                    Tus datos no son moneda de cambio
                </h2>
                <p class="text-text-muted font-sans text-base sm:text-lg mb-6 leading-relaxed font-medium">
                    Las plataformas comerciales gratuitas se financian
                    recopilando, analizando y utilizando información para fines
                    publicitarios. Utilizar infraestructura de terceros para
                    investigaciones universitarias pone en riesgo la
                    confidencialidad y propiedad del estudio.
                </p>
                <p class="text-text-muted font-sans text-base sm:text-lg leading-relaxed font-medium">
                    <strong class="text-ink font-bold">
                        DATAUMSA opera bajo el principio de soberanía
                        tecnológica.
                    </strong>{" "}
                    Toda la información recolectada se almacena en servidores
                    gestionados y asegurados localmente por la universidad.
                    Nadie fuera de tu equipo tiene acceso a tu base de datos.
                </p>
            </div>

            <!-- Bento Card Servidor Protegido -->
            <div class="w-full bg-midnight-surface rounded-card border-[2.5px] border-ink p-8 flex flex-col justify-between text-white relative overflow-hidden">
                <!-- Header status terminal -->
                <div class="relative z-10 flex items-center justify-between border-b-2 border-ink pb-4 mb-6">
                    <span class="font-mono text-xs font-bold text-text-dark-muted uppercase tracking-wider">
                        ESTADO: MONITOREADO 24/7
                    </span>
                    <div class="flex gap-2">
                        <span class="w-3 h-3 rounded-full bg-success border border-ink"></span>
                        <span class="w-3 h-3 rounded-full bg-primary border border-ink"></span>
                        <span class="w-3 h-3 rounded-full bg-accent border border-ink"></span>
                    </div>
                </div>

                <div class="relative z-10 text-center flex flex-col items-center justify-center py-8">
                    <div class="w-20 h-20 rounded-2xl bg-white border-2 border-ink flex items-center justify-center mb-5">
                        <FiDatabase className="w-10 h-10 text-ink" />
                    </div>
                    <h3 class="text-white font-display font-extrabold text-2xl mb-2 tracking-tight">
                        Servidor UMSA Aislado
                    </h3>
                    <p class="text-primary font-mono text-sm font-bold bg-midnight px-4 py-1.5 rounded-full border border-ink">
                        Cifrado Extremo a Extremo
                    </p>
                </div>

                <div class="relative z-10 border-t-2 border-ink pt-4 flex justify-between items-center text-xs font-mono text-text-dark-muted">
                    <span>Normativa UMSA 2026</span>
                    <span class="text-success font-bold">100% Soberano</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Lógica Avanzada XLSForm (Main Canvas) -->
    <section class="w-full py-16 lg:py-24 bg-canvas">
        <div class="max-w-300 mx-auto px-4 sm:px-6">
            <div class="text-center max-w-3xl mx-auto mb-14">
                <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-ink mb-5 leading-tight tracking-tight">
                    El verdadero poder está en la{" "}
                    <TextReveal variant="light">Lógica</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base sm:text-lg leading-relaxed font-medium">
                    Mientras las herramientas comunes se limitan a "ir a la
                    siguiente sección", DATAUMSA utiliza el estándar{" "}
                    <strong class="text-ink font-bold">XLSForm</strong>,
                    permitiendo validaciones, cálculos y matrices complejas para
                    evitar errores de captura en campo.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
                <!-- Bento 1 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-8 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center text-ink mb-5">
                            <FiCode className="w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold font-display text-ink mb-3 tracking-tight">
                            Validación Regex
                        </h3>
                        <p class="text-sm font-medium text-text-muted leading-relaxed font-sans">
                            Fuerza formatos específicos. Verifica
                            automáticamente que un carnet, correo o código de
                            matrícula esté escrito correctamente antes de
                            permitir avanzar.
                        </p>
                    </div>
                </div>

                <!-- Bento 2 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-8 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center text-ink mb-5">
                            <FiLayers className="w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold font-display text-ink mb-3 tracking-tight">
                            Saltos Condicionales
                        </h3>
                        <p class="text-sm font-medium text-text-muted leading-relaxed font-sans">
                            Crea árboles lógicos complejos. Muestra u oculta
                            preguntas basándote en la combinación de múltiples
                            respuestas previas del encuestado.
                        </p>
                    </div>
                </div>

                <!-- Bento 3 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-8 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                    <div>
                        <div class="w-14 h-14 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center text-ink mb-5">
                            <FiActivity className="w-7 h-7" />
                        </div>
                        <h3 class="text-xl font-bold font-display text-ink mb-3 tracking-tight">
                            Cálculos en Tiempo Real
                        </h3>
                        <p class="text-sm font-medium text-text-muted leading-relaxed font-sans">
                            Suma valores, calcula edades a partir de fechas de
                            nacimiento o genera scores automáticos sin que el
                            encuestador tenga que hacer cuentas en campo.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Trabajo de Campo (Midnight Band) -->
    <section class="w-full py-16 lg:py-24 bg-midnight text-white border-y-[2.5px] border-ink">
        <div class="max-w-300 mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
            <div class="lg:col-span-5 flex justify-center">
                <!-- Mockup Celular con estética Bento de bordes sólidos -->
                <div class="w-full max-w-sm rounded-[2.5rem] border-3 border-ink bg-midnight-surface p-6 relative">
                    <div class="w-28 h-5 bg-midnight border-b-2 border-x-2 border-ink rounded-b-xl absolute top-0 left-1/2 -translate-x-1/2"></div>

                    <div class="flex flex-col gap-4 mt-6">
                        <div class="w-full bg-midnight rounded-2xl p-4 border-2 border-ink">
                            <div class="flex items-center gap-2.5 mb-2">
                                <FiMapPin className="text-primary" />
                                <span class="text-sm font-bold text-white">
                                    Captura GPS (Offline)
                                </span>
                            </div>
                            <div class="w-full h-2.5 bg-midnight-surface rounded-full border border-ink">
                                <div class="w-full h-full bg-success rounded-full"></div>
                            </div>
                        </div>

                        <div class="w-full bg-midnight rounded-2xl p-4 border-2 border-ink">
                            <div class="flex items-center gap-2.5 mb-2">
                                <FiCamera className="text-primary" />
                                <span class="text-sm font-bold text-white">
                                    Fotografía con Firma
                                </span>
                            </div>
                            <div class="w-full h-2.5 bg-midnight-surface rounded-full border border-ink">
                                <div class="w-full h-full bg-success rounded-full"></div>
                            </div>
                        </div>

                        <div class="w-full bg-primary-light rounded-2xl p-3.5 border-2 border-ink text-ink flex items-center justify-center gap-2 font-bold text-sm">
                            <FiCheck
                                className="w-5 h-5 text-ink"
                                strokeWidth={3}
                            />
                            <span>Sin restricciones de pago</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-7">
                <Badge variant="primary" class="mb-4">
                    DATAUMSA Collect
                </Badge>
                <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white mb-6 leading-tight tracking-tight">
                    El trabajo de campo no tiene internet. <br />{" "}
                    <span class="text-primary">
                        Ni debería requerir una suscripción.
                    </span>
                </h2>
                <p class="text-text-dark-muted font-sans text-base sm:text-lg mb-6 leading-relaxed font-medium">
                    Alternativas comerciales de encuestas móviles como{" "}
                    <em>SurveyHeart</em> esconden funciones esenciales (como
                    lógica avanzada, saltos o captura de coordenadas) detrás de
                    muros de pago.
                </p>
                <p class="text-text-dark-muted font-sans text-base sm:text-lg leading-relaxed font-medium">
                    Nuestra aplicación nativa te permite encuestar en
                    comunidades rurales totalmente{" "}
                    <strong class="text-white font-bold">fuera de línea</strong>
                    . Captura coordenadas satelitales, audios del entorno,
                    firmas y fotografías. Al recuperar señal, los datos se
                    sincronizan directamente con la universidad.
                </p>
            </div>
        </div>
    </section>

    <!-- 5. Ecosistema Científico (Main Canvas) -->
    <section class="w-full py-16 lg:py-24 bg-canvas flex flex-col items-center">
        <div class="max-w-300 mx-auto px-4 sm:px-6 text-center">
            <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-ink mb-5 leading-tight tracking-tight">
                Preparado para el análisis de{" "}
                <TextReveal variant="light">Ciencia de Datos</TextReveal>
            </h2>
            <p class="text-text-muted font-sans text-base sm:text-lg leading-relaxed mb-12 max-w-2xl mx-auto font-medium">
                No te limites a exportar en hojas de cálculo. DATAUMSA genera
                bases de datos estructuradas y limpias listas para ser ingeridas
                directamente por el software estadístico que utilizas en tus
                materias e investigaciones.
            </p>

            <div class="flex flex-wrap justify-center gap-4 sm:gap-6">
                <!-- R / RStudio -->
                <div class="bg-white border-[2.5px] border-ink rounded-[1.75rem] px-6 py-6 flex flex-col items-center justify-center w-40 hover:-translate-y-1 transition-transform duration-200">
                    <svg
                        class="w-12 h-12 mb-3"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 32 32"
                    >
                        <defs>
                            <linearGradient
                                id="SVGKqV9jdVi"
                                x1="-134.811"
                                x2="-134.772"
                                y1="-103.284"
                                y2="-103.323"
                                gradientTransform="matrix(721.094 0 0 -482.937 97213.595 -49874.512)"
                                gradientUnits="userSpaceOnUse"
                            >
                                <stop offset="0" stop-color="#cbced0" />
                                <stop offset="1" stop-color="#84838b" />
                            </linearGradient>
                            <linearGradient
                                id="SVG5aLaoevq"
                                x1="-135.378"
                                x2="-135.339"
                                y1="-102.985"
                                y2="-103.024"
                                gradientTransform="matrix(398 0 0 -406.124 53893 -41812.836)"
                                gradientUnits="userSpaceOnUse"
                            >
                                <stop offset="0" stop-color="#276dc3" />
                                <stop offset="1" stop-color="#165caa" />
                            </linearGradient>
                        </defs>
                        <path
                            fill="url(#SVGKqV9jdVi)"
                            d="M16 23.956c-7.732 0-14-4.2-14-9.376S8.268 5.2 16 5.2s14 4.2 14 9.38s-6.268 9.376-14 9.376M18.143 8.87C12.266 8.87 7.5 11.74 7.5 15.28s4.764 6.41 10.641 6.41s10.214-1.962 10.214-6.41s-4.335-6.41-10.212-6.41"
                        />
                        <path
                            fill="url(#SVG5aLaoevq)"
                            d="M23.321 19.726a11 11 0 0 1 1.34.5a2.6 2.6 0 0 1 .68.485a1.8 1.8 0 0 1 .311.447l3.339 5.63h-5.4l-2.524-4.74a6 6 0 0 0-.835-1.145a.88.88 0 0 0-.641-.291h-1.28v6.173h-4.776V11.026h9.591s4.374.074 4.374 4.235s-4.179 4.465-4.179 4.465m-2.077-5.28h-2.891v2.681h2.893a1.323 1.323 0 0 0 1.34-1.364a1.247 1.247 0 0 0-1.342-1.316Z"
                        />
                    </svg>
                    <span class="text-xs text-ink font-mono font-bold tracking-wider uppercase">
                        R / RStudio
                    </span>
                </div>

                <!-- Python / Pandas -->
                <div class="bg-white border-[2.5px] border-ink rounded-[1.75rem] px-6 py-6 flex flex-col items-center justify-center w-40 hover:-translate-y-1 transition-transform duration-200">
                    <svg
                        class="w-12 h-12 mb-3"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 128 128"
                    >
                        <linearGradient
                            id="SVGtryZab8W"
                            x1="70.252"
                            x2="170.659"
                            y1="1237.476"
                            y2="1151.089"
                            gradientTransform="matrix(.563 0 0 -.568 -29.215 707.817)"
                            gradientUnits="userSpaceOnUse"
                        >
                            <stop offset="0" stop-color="#5a9fd4" />
                            <stop offset="1" stop-color="#306998" />
                        </linearGradient>
                        <linearGradient
                            id="SVGe9yX9dAA"
                            x1="209.474"
                            x2="173.62"
                            y1="1098.811"
                            y2="1149.537"
                            gradientTransform="matrix(.563 0 0 -.568 -29.215 707.817)"
                            gradientUnits="userSpaceOnUse"
                        >
                            <stop offset="0" stop-color="#ffd43b" />
                            <stop offset="1" stop-color="#ffe873" />
                        </linearGradient>
                        <path
                            fill="url(#SVGtryZab8W)"
                            d="M63.391 1.988c-4.222.02-8.252.379-11.8 1.007c-10.45 1.846-12.346 5.71-12.346 12.837v9.411h24.693v3.137H29.977c-7.176 0-13.46 4.313-15.426 12.521c-2.268 9.405-2.368 15.275 0 25.096c1.755 7.311 5.947 12.519 13.124 12.519h8.491V67.234c0-8.151 7.051-15.34 15.426-15.34h24.665c6.866 0 12.346-5.654 12.346-12.548V15.833c0-6.693-5.646-11.72-12.346-12.837c-4.244-.706-8.645-1.027-12.866-1.008M50.037 9.557c2.55 0 4.634 2.117 4.634 4.721c0 2.593-2.083 4.69-4.634 4.69c-2.56 0-4.633-2.097-4.633-4.69c-.001-2.604 2.073-4.721 4.633-4.721"
                            transform="translate(0 10.26)"
                        />
                        <path
                            fill="url(#SVGe9yX9dAA)"
                            d="M91.682 28.38v10.966c0 8.5-7.208 15.655-15.426 15.655H51.591c-6.756 0-12.346 5.783-12.346 12.549v23.515c0 6.691 5.818 10.628 12.346 12.547c7.816 2.297 15.312 2.713 24.665 0c6.216-1.801 12.346-5.423 12.346-12.547v-9.412H63.938v-3.138h37.012c7.176 0 9.852-5.005 12.348-12.519c2.578-7.735 2.467-15.174 0-25.096c-1.774-7.145-5.161-12.521-12.348-12.521h-9.268zM77.809 87.927c2.561 0 4.634 2.097 4.634 4.692c0 2.602-2.074 4.719-4.634 4.719c-2.55 0-4.633-2.117-4.633-4.719c0-2.595 2.083-4.692 4.633-4.692"
                            transform="translate(0 10.26)"
                        />
                    </svg>
                    <span class="text-xs text-ink font-mono font-bold tracking-wider uppercase">
                        Python / Pandas
                    </span>
                </div>

                <!-- SPSS / IBM -->
                <div class="bg-white border-[2.5px] border-ink rounded-[1.75rem] px-6 py-6 flex flex-col items-center justify-center w-40 hover:-translate-y-1 transition-transform duration-200">
                    <svg
                        class="w-12 h-12 mb-3 text-[#CC1E4A]"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 128 128"
                    >
