---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/components-astro/Badge.astro";
import Button from "../../components/components-astro/Button.astro";
import TextReveal from "../../components/components-astro/TextReveal.astro";
import {
    FiBookOpen,
    FiCalendar,
    FiCheckCircle,
    FiFileText,
    FiTrendingUp,
    FiGlobe,
    FiUsers,
    FiArrowRight,
} from "react-icons/fi";
---

<Layout
    title="Nuestra Historia | DATAUMSA"
    description="Descubre el origen de DATAUMSA, desde una iniciativa estudiantil para el Censo Universitario 2025 hasta convertirse en un proyecto de vocación institucional."
>
    <!-- 1. Split Hero Section (Main Canvas) -->
    <section class="w-full py-16 md:py-24 bg-canvas flex flex-col items-center">
        <div class="max-w-300 w-full mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
            <!-- Texto de Introducción -->
            <div class="lg:col-span-7 flex flex-col justify-center">
                <Badge variant="primary" class="mb-5 self-start">
                    Nuestros Orígenes
                </Badge>
                <h1 class="text-ink font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] leading-[1.08] mb-5">
                    Nuestra <TextReveal variant="light">Historia</TextReveal>
                </h1>
                <p class="text-text-muted font-sans text-base sm:text-lg md:text-xl leading-relaxed mb-8 max-w-2xl font-medium">
                    El camino recorrido desde una iniciativa de estudiantes de
                    Estadística e Informática hasta consolidar{" "}
                    <strong class="text-ink font-bold">DATAUMSA</strong>, un
                    proyecto tecnológico con vocación institucional para la
                    Universidad Mayor de San Andrés.
                </p>
                <div class="flex flex-wrap gap-4">
                    <Button
                        href="#hitos"
                        variant="bento-primary"
                        class="text-sm py-3 px-6"
                    >
                        <span>Ver los Hitos</span>
                    </Button>
                    <Button
                        href="/sobre-dataumsa/equipo-institucional"
                        variant="bento-secondary"
                        class="text-sm py-3 px-6"
                    >
                        <span>Conocer al Equipo</span>
                    </Button>
                </div>
            </div>

            <!-- Ilustración Pop-Art: Transición de papel a digital -->
            <div class="lg:col-span-5 flex items-center justify-center relative min-h-[350px]">
                <div class="w-72 h-72 relative flex items-center justify-center select-none">
                    <!-- Celular Digitalizador (Derecha, Midnight Surface) -->
                    <div class="absolute w-48 h-72 rounded-4xl border-[3.5px] border-ink bg-midnight-surface translate-x-10 translate-y-4 rotate-[8deg] flex flex-col justify-between p-3.5 overflow-hidden text-white z-20">
                        <div class="w-16 h-3 bg-midnight border-b border-x border-ink rounded-b-lg mx-auto"></div>
                        <div class="grow flex flex-col gap-2.5 justify-center">
                            <div class="w-full h-14 rounded-xl bg-primary border-2 border-ink flex items-center justify-center text-ink">
                                <FiCheckCircle
                                    className="w-7 h-7"
                                    strokeWidth={2.5}
                                />
                            </div>
                            <div class="flex flex-col gap-1 px-1">
                                <span class="text-xs font-mono font-bold text-primary">
                                    DATAUMSA
                                </span>
                                <span class="text-[11px] font-sans text-text-dark-muted">
                                    100% Digital
                                </span>
                            </div>
                        </div>
                        <div class="w-full bg-success border border-ink text-ink text-[10px] font-mono font-bold py-1 text-center rounded-full">
                            SINCRONIZADO
                        </div>
                    </div>

                    <!-- Hoja de Papel Tradicional (Izquierda, White Plate) -->
                    <div class="absolute w-44 h-60 bg-white border-[2.5px] border-ink rounded-2xl -translate-x-12 -translate-y-6 -rotate-12 p-4 flex flex-col justify-between z-10 hover:rotate-0 transition-transform duration-300">
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center gap-2 border-b-2 border-ink pb-2">
                                <FiFileText className="text-ink w-4 h-4" />
                                <span class="text-xs font-mono font-bold text-ink">
                                    CENSO 2025
                                </span>
                            </div>
                            <div class="w-full h-2 bg-primary-light border border-ink rounded-md"></div>
                            <div class="w-3/4 h-2 bg-primary-light border border-ink rounded-md"></div>
                            <div class="w-4/5 h-2 bg-primary-light border border-ink rounded-md"></div>
                        </div>
                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-warning border border-ink text-ink self-start">
                            Método Tradicional
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Hitos de la Historia (Cyan Light Band) -->
    <section
        id="hitos"
        class="w-full py-16 lg:py-24 bg-primary-light border-y-[2.5px] border-ink flex flex-col items-center"
    >
        <div class="max-w-275 w-full mx-auto px-4 sm:px-6">
            <!-- Encabezado de la sección -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <Badge variant="primary" class="mb-4">
                    Línea de Tiempo
                </Badge>
                <h2 class="text-ink font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] leading-tight">
                    Hitos de nuestra{" "}
                    <TextReveal variant="light">evolución</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base sm:text-lg mt-4 font-medium leading-relaxed">
                    De resolver una urgencia operativa en las aulas a forjar una
                    herramienta de alcance institucional para toda la UMSA.
                </p>
            </div>

            <!-- Bento Stack de Hitos -->
            <div class="flex flex-col gap-8">
                <!-- HITO 1: EL ORIGEN -->
                <div class="bg-white border-[2.5px] border-ink rounded-[2.5rem] p-7 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center hover:-translate-y-1 transition-transform duration-200">
                    <div class="lg:col-span-7 flex flex-col">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-10 h-10 rounded-xl bg-primary text-ink border-2 border-ink font-mono font-extrabold text-sm flex items-center justify-center">
                                01
                            </div>
                            <span class="text-xs font-mono font-bold uppercase tracking-wider text-primary-dark">
                                Origen // Censo 2025
                            </span>
                        </div>
                        <h3 class="text-ink font-display text-2xl sm:text-3xl font-extrabold tracking-tight mb-4">
                            El reto de digitalizar la universidad
                        </h3>
                        <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                            <strong class="text-ink font-bold">DATAUMSA</strong>{" "}
                            nació como una iniciativa de estudiantes de las
                            carreras de{" "}
                            <strong class="text-ink font-bold">
                                Estadística e Informática
                            </strong>{" "}
                            de la Universidad Mayor de San Andrés. Su origen
                            responde a una necesidad concreta: la realización
                            del{" "}
                            <strong class="text-ink font-bold">
                                Censo Universitario 2025
                            </strong>
                            . Frente a la posibilidad de llevar a cabo el censo
                            mediante métodos tradicionales de papel y lápiz, el
                            equipo identificó la oportunidad de automatizar y
                            digitalizar todo el proceso de recolección de datos.
                            Así surgió{" "}
                            <strong class="text-ink font-bold">DATAUMSA</strong>
                            , una plataforma desarrollada internamente para
                            responder a las demandas reales de la universidad.
                        </p>
                    </div>

                    <div class="lg:col-span-5 flex justify-center">
                        <div class="w-full max-w-80 rounded-2xl bg-canvas border-2 border-ink p-4 flex items-center justify-around">
                            <!-- Hoja Cancelada -->
                            <div class="w-24 h-32 bg-white border-2 border-ink rounded-xl p-2.5 flex flex-col justify-between relative">
                                <div class="w-full h-1.5 bg-[#cbd5e1] rounded-xs"></div>
                                <div class="w-3/4 h-1.5 bg-[#cbd5e1] rounded-xs"></div>
                                <div class="w-full h-1.5 bg-[#cbd5e1] rounded-xs"></div>
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <span class="w-16 h-1 bg-danger rotate-45 absolute rounded-full"></span>
                                    <span class="w-16 h-1 bg-danger -rotate-45 absolute rounded-full"></span>
                                </div>
                            </div>
                            <FiArrowRight
                                className="w-6 h-6 text-ink"
                                strokeWidth={2.5}
                            />
                            <!-- Servidor DATAUMSA -->
                            <div class="w-28 h-32 rounded-xl bg-midnight-surface border-2 border-ink p-3 flex flex-col justify-between text-white font-mono">
                                <div class="w-full h-6 rounded-md bg-primary border border-ink flex items-center justify-center text-[10px] font-bold text-ink">
                                    SQL_DATA
                                </div>
                                <div class="w-full h-1.5 bg-midnight rounded-full overflow-hidden">
                                    <div class="w-full h-full bg-success"></div>
                                </div>
                                <span class="text-[10px] text-primary font-bold text-center">
                                    DATAUMSA
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HITO 2: VALIDACIÓN TÉCNICA -->
                <div class="bg-white border-[2.5px] border-ink rounded-[2.5rem] p-7 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center hover:-translate-y-1 transition-transform duration-200">
                    <div class="lg:col-span-7 flex flex-col">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-10 h-10 rounded-xl bg-success text-ink border-2 border-ink font-mono font-extrabold text-sm flex items-center justify-center">
                                02
                            </div>
                            <span class="text-xs font-mono font-bold uppercase tracking-wider text-success">
                                Impacto // Cobertura
                            </span>
                        </div>
                        <h3 class="text-ink font-display text-2xl sm:text-3xl font-extrabold tracking-tight mb-4">
                            Más del 95% de cobertura estudiantil
                        </h3>
                        <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                            Gracias a{" "}
                            <strong class="text-ink font-bold">DATAUMSA</strong>{" "}
                            se logró censar a{" "}
                            <strong class="text-ink font-bold">
                                más de 65.000 estudiantes
                            </strong>{" "}
                            —superando el 95% de la matrícula universitaria—
                            mediante un modelo de autocenso digital directo y
                            sin intermediarios. Este hito validó la capacidad
                            técnica y la eficiencia en costos de la plataforma:
                            con una brigada técnica de apenas 30 censistas
                            dedicados a autoridades y apoyo presencial
                            focalizado a docentes, los servidores en el
                            Datacenter UMSA procesaron el flujo de datos masivo
                            sin interrupciones ni pérdida de información.
                        </p>
                    </div>

                    <div class="lg:col-span-5 flex justify-center">
                        <div class="w-full max-w-80 rounded-2xl bg-midnight-surface border-2 border-ink p-6 flex flex-col items-center justify-center text-white">
                            <div class="w-28 h-28 rounded-full bg-midnight border-2 border-ink flex flex-col items-center justify-center relative overflow-hidden">
                                <span class="text-3xl font-black text-primary font-display">
                                    95%+
                                </span>
                                <span class="text-[10px] font-mono font-bold text-text-dark-muted uppercase">
                                    Autocenso
                                </span>
                            </div>
                            <span class="text-xs font-mono font-bold text-success mt-3 bg-success/20 border border-success/40 px-3 py-1 rounded-full">
                                +65.000 Estudiantes
                            </span>
                        </div>
                    </div>
                </div>

                <!-- HITO 3: VOCACIÓN INSTITUCIONAL -->
                <div class="bg-white border-[2.5px] border-ink rounded-[2.5rem] p-7 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center hover:-translate-y-1 transition-transform duration-200">
                    <div class="lg:col-span-7 flex flex-col">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-10 h-10 rounded-xl bg-accent text-white border-2 border-ink font-mono font-extrabold text-sm flex items-center justify-center">
                                03
                            </div>
                            <span class="text-xs font-mono font-bold uppercase tracking-wider text-accent">
                                Visión // Proyección
                            </span>
                        </div>
                        <h3 class="text-ink font-display text-2xl sm:text-3xl font-extrabold tracking-tight mb-4">
                            Vocación e impacto institucional
                        </h3>
                        <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                            Impulsada por la innovación y la convicción de que
                            los universitarios e investigadores merecen
                            herramientas avanzadas para la recolección de datos,{" "}
                            <strong class="text-ink font-bold">DATAUMSA</strong>{" "}
                            busca trascender su uso inicial y consolidarse como
                            una solución estratégica para toda la comunidad
                            universitaria, abriendo el camino para tesis de
                            grado, censos sectoriales y diagnósticos sociales.
                        </p>
                    </div>

                    <div class="lg:col-span-5 flex justify-center">
                        <div class="w-full max-w-80 rounded-2xl bg-canvas border-2 border-ink p-6 flex flex-col items-center justify-center">
                            <div class="w-24 h-24 rounded-full border-2 border-dashed border-ink flex items-center justify-center bg-white relative">
                                <span class="text-xl font-black font-display text-ink">
                                    UMSA
                                </span>
                                <div class="absolute -top-2 px-2 py-0.5 rounded-full bg-primary border border-ink text-[9px] font-mono font-bold text-ink">
                                    OFICIAL
                                </div>
                            </div>
                            <span class="text-xs font-mono font-bold text-ink mt-3">
                                Soberanía Académica
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Banner de Cierre Cita (Midnight Band) -->
    <section class="w-full py-16 lg:py-24 bg-midnight text-white border-t-[2.5px] border-ink flex justify-center">
        <div class="max-w-250 w-full mx-4 sm:mx-6 text-center bg-midnight-surface border-3 border-ink rounded-[2.5rem] p-8 md:p-14 relative z-10 flex flex-col items-center gap-6">
            <span class="w-12 h-1 bg-primary rounded-full mb-2"></span>
            <blockquote class="text-white font-display text-2xl md:text-3xl lg:text-4xl font-extrabold italic tracking-tight leading-snug max-w-3xl">
                "De una necesidad específica, nació un proyecto con vocación
                institucional."
            </blockquote>
            <p class="text-text-dark-muted font-sans text-base sm:text-lg max-w-md font-medium leading-relaxed">
                Conoce al equipo técnico y académico que impulsa la plataforma
                de datos soberana <strong class="text-white">DATAUMSA</strong>.
            </p>
            <Button
                href="/sobre-dataumsa/equipo-institucional"
                variant="bento-primary"
                class="text-sm py-3 px-6"
            >
                <span>Conocer el Equipo</span>
                <FiArrowRight className="w-4 h-4 ml-1.5" />
            </Button>
        </div>
    </section>
</Layout>
