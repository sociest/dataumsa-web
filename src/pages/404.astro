---
import Layout from "../layouts/Layout.astro";
import Button from "../components/components-astro/Button.astro";
---

<Layout title="Página no encontrada" description="La página que estás buscando no existe o ha sido movida.">
  <div class="flex flex-col items-center justify-center text-center py-20 px-4 min-h-[60vh] max-w-200 mx-auto animate-fade-in">
    <div class="badge mb-6">Error 404</div>
    <h1 class="text-8xl font-black mb-4 tracking-tight text-primary-dark">
      404
    </h1>
    <h2 class="text-3xl font-bold text-text-main mb-4">Página no encontrada</h2>
    <p class="text-text-muted text-lg max-w-md mb-8 leading-relaxed">
      Lo sentimos, la página que buscas no existe, ha sido eliminada o cambió de dirección.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href="/" variant="primary" class="font-semibold">
        Volver al Inicio
      </Button>
      <Button href="/la-plataforma/caracteristicas" variant="secondary" class="font-semibold">
        Explorar la Plataforma
      </Button>
    </div>
  </div>
</Layout>
