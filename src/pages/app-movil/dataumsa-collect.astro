---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/components-astro/Badge.astro";
import Button from "../../components/components-astro/Button.astro";
import TextReveal from "../../components/components-astro/TextReveal.astro";
import {
    FiWifiOff,
    FiRefreshCw,
    FiLayers,
    FiClipboard,
    FiArrowRight,
    FiDownload,
    FiSmartphone,
    FiDatabase,
    FiCheck,
    FiCheckCircle,
    FiMapPin,
    FiLock,
    FiPlay,
    FiEye,
    FiServer,
} from "react-icons/fi";
---

<Layout
    title="DATAUMSA Collect | Aplicación Móvil"
    description="Conoce DATAUMSA Collect, la aplicación oficial para la recolección de datos en campo de manera offline, rápida y de alta fidelidad."
>
    <!-- 1. Hero Section Split (Main Canvas) -->
    <section class="w-full py-16 md:py-24 bg-canvas flex flex-col items-center">
        <div class="max-w-300 w-full mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
            <!-- Texto de Presentación -->
            <div class="lg:col-span-7 flex flex-col justify-center">
                <Badge variant="primary" class="mb-5 self-start">
                    Aplicación Oficial Android
                </Badge>
                <h1 class="text-ink font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] leading-[1.08] mb-5">
                    DATAUMSA <TextReveal variant="light">Collect</TextReveal>
                </h1>
                <p class="text-ink font-display text-xl sm:text-2xl font-bold mb-4 tracking-tight">
                    La potencia del XLSForm en la palma de tu mano.
                </p>
                <p class="text-text-muted font-sans text-base sm:text-lg leading-relaxed mb-8 max-w-xl font-medium">
                    La herramienta definitiva para la recolección de información
                    en campo. Registra cuestionarios estructurados con total
                    validez científica, georreferenciación y soporte multimedia,
                    operando al 100% sin conexión a internet.
                </p>
                <div class="flex flex-wrap gap-4">
                    <Button
                        href="/app-movil/descargas"
                        variant="bento-primary"
                        class="text-sm py-3 px-6"
                    >
                        <FiDownload className="w-4 h-4 mr-1.5" />
                        <span>Descargar Aplicación</span>
                    </Button>
                    <Button
                        href="#caracteristicas"
                        variant="bento-secondary"
                        class="text-sm py-3 px-6"
                    >
                        <span>Explorar Características</span>
                    </Button>
                </div>
            </div>

            <!-- Smartphone Mockup con Estilo Bento Pop-Art -->
            <div class="lg:col-span-5 flex items-center justify-center relative">
                <div class="w-75 rounded-[2.5rem] border-[3.5px] border-ink bg-midnight-surface p-5 relative overflow-hidden flex flex-col justify-between text-white">
                    <!-- Notch del Teléfono -->
                    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-5 bg-midnight border-b-2 border-x-2 border-ink rounded-b-xl z-20 flex items-center justify-center">
                        <div class="w-10 h-1 bg-white/40 rounded-full mb-0.5"></div>
                    </div>

                    <!-- App Header -->
                    <div class="pt-4 flex justify-between items-center border-b-2 border-ink pb-3 mb-3">
                        <div class="flex flex-col">
                            <span class="text-xs font-bold text-white font-display">
                                DATAUMSA Collect
                            </span>
                            <span class="text-[11px] text-text-dark-muted font-mono">
                                ID: #4829
                            </span>
                        </div>
                        <div class="flex items-center gap-1.5 bg-success border border-ink text-ink px-2.5 py-0.5 rounded-full text-xs font-bold">
                            <span class="w-1.5 h-1.5 rounded-full bg-ink"></span>{" "}
                            Activa
                        </div>
                    </div>

                    <!-- App Screen Content (Mock Formulario Bento) -->
                    <div class="py-2 flex flex-col gap-3.5">
                        <div class="bg-midnight border-2 border-ink p-3 rounded-2xl flex flex-col gap-1">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-text-dark-muted font-mono">
                                Proyecto Activo
                            </span>
                            <span class="text-xs font-bold text-white font-display leading-tight">
                                Censo de Infraestructura Facultad de Ciencias
                            </span>
                        </div>

                        <!-- Input 1: Opciones Bento -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[11px] font-bold uppercase tracking-wider text-text-dark-muted font-mono">
                                1. Nivel de Mantenimiento
                            </label>
                            <div class="grid grid-cols-3 gap-1.5">
                                <span class="border-2 border-ink bg-primary text-ink text-xs font-bold py-1.5 rounded-xl text-center">
                                    Bueno
                                </span>
                                <span class="border border-ink bg-midnight text-text-dark-muted text-xs font-medium py-1.5 rounded-xl text-center">
                                    Regular
                                </span>
                                <span class="border border-ink bg-midnight text-text-dark-muted text-xs font-medium py-1.5 rounded-xl text-center">
                                    Crítico
                                </span>
                            </div>
                        </div>

                        <!-- Input 2: GPS con sticker -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[11px] font-bold uppercase tracking-wider text-text-dark-muted font-mono">
                                2. Ubicación GPS
                            </label>
                            <div class="flex gap-2 items-center px-3 py-2 bg-midnight border-2 border-ink rounded-xl text-white">
                                <FiMapPin className="w-3.5 h-3.5 text-primary shrink-0" />
                                <span class="text-xs font-mono font-bold text-white">
                                    16.5029º S, 68.1205º W
                                </span>
                            </div>
                        </div>

                        <!-- Input 3: Checklist -->
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[11px] font-bold uppercase tracking-wider text-text-dark-muted font-mono">
                                3. Inventario verificado
                            </label>
                            <div class="flex flex-col gap-1.5 bg-midnight border-2 border-ink p-2.5 rounded-xl">
                                <label class="flex items-center gap-2 text-xs text-white font-medium">
                                    <div class="w-4 h-4 rounded bg-success border border-ink flex items-center justify-center text-ink">
                                        <FiCheck
                                            className="w-3.5 h-3.5"
                                            strokeWidth={3}
                                        />
                                    </div>
                                    Equipos de Computación
                                </label>
                                <label class="flex items-center gap-2 text-xs text-white font-medium">
                                    <div class="w-4 h-4 rounded bg-success border border-ink flex items-center justify-center text-ink">
                                        <FiCheck
                                            className="w-3.5 h-3.5"
                                            strokeWidth={3}
                                        />
                                    </div>
                                    Conexión de Red
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- App Footer Sincronizar -->
                    <div class="pt-3 border-t-2 border-ink flex flex-col gap-1.5 mt-2">
                        <div class="w-full bg-primary border-2 border-ink text-ink rounded-full py-2 px-4 flex items-center justify-between font-bold text-xs uppercase tracking-wider">
                            <span>Sincronizado</span>
                            <FiCheckCircle
                                className="w-4 h-4 text-ink"
                                strokeWidth={2.5}
                            />
                        </div>
                        <span class="text-[10px] text-center text-text-dark-muted font-medium font-mono">
                            100% de datos en la nube UMSA
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Características Principales (Cyan Light Band) -->
    <section
        id="caracteristicas"
        class="w-full py-16 lg:py-24 bg-primary-light border-y-[2.5px] border-ink flex flex-col items-center"
    >
        <div class="max-w-300 w-full mx-auto px-4 sm:px-6">
            <!-- Encabezado de la sección -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <Badge variant="primary" class="mb-4">
                    Características Clave
                </Badge>
                <h2 class="text-ink font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] leading-tight">
                    Diseñada para las condiciones{" "}
                    <TextReveal variant="light">más exigentes</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base sm:text-lg mt-4 font-medium leading-relaxed">
                    Lejos de ser una aplicación común de encuestas, DATAUMSA
                    Collect es una herramienta de ingeniería de datos optimizada
                    para el rigor científico.
                </p>
            </div>

            <!-- Bento Grid 2x2 de Características -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
                <!-- CARD 1: Trabajo sin internet (Offline) -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-8 flex flex-col sm:flex-row gap-6 items-start sm:items-center hover:-translate-y-1 transition-transform duration-200">
                    <div class="w-24 h-24 rounded-2xl bg-primary-light border-2 border-ink shrink-0 flex items-center justify-center relative">
                        <FiWifiOff
                            className="w-10 h-10 text-ink"
                            strokeWidth={2}
                        />
                        <span class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded-full bg-warning border border-ink text-[10px] font-mono font-bold text-ink">
                            OFFLINE
                        </span>
                    </div>

                    <div class="flex flex-col gap-2">
                        <h3 class="text-ink font-display text-xl sm:text-2xl font-bold tracking-tight">
                            Trabajo sin internet
                        </h3>
                        <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                            Funciona completamente fuera de línea. Los datos y
                            recursos multimedia se guardan de forma encriptada
                            en la base local del dispositivo, garantizando cero
                            pérdida de información.
                        </p>
                    </div>
                </div>

                <!-- CARD 2: Conexión automática -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-8 flex flex-col sm:flex-row gap-6 items-start sm:items-center hover:-translate-y-1 transition-transform duration-200">
                    <div class="w-24 h-24 rounded-2xl bg-primary-light border-2 border-ink shrink-0 flex items-center justify-center relative">
                        <FiServer
                            className="w-10 h-10 text-ink"
                            strokeWidth={2}
                        />
                        <span class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded-full bg-success border border-ink text-[10px] font-mono font-bold text-ink">
                            AUTO
                        </span>
                    </div>

                    <div class="flex flex-col gap-2">
                        <h3 class="text-ink font-display text-xl sm:text-2xl font-bold tracking-tight">
                            Conexión automática
                        </h3>
                        <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                            Se conecta de manera automática y directa con los
                            servidores centrales de la UMSA. Sin configuraciones
                            complejas: solo inicia sesión y sincroniza de forma
                            segura.
                        </p>
                    </div>
                </div>

                <!-- CARD 3: Formularios avanzados -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-8 flex flex-col sm:flex-row gap-6 items-start sm:items-center hover:-translate-y-1 transition-transform duration-200">
                    <div class="w-24 h-24 rounded-2xl bg-primary-light border-2 border-ink shrink-0 flex items-center justify-center relative">
                        <FiLayers
                            className="w-10 h-10 text-ink"
                            strokeWidth={2}
                        />
                        <span class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded-full bg-accent border border-ink text-[10px] font-mono font-bold text-white">
                            XLS
                        </span>
                    </div>

                    <div class="flex flex-col gap-2">
                        <h3 class="text-ink font-display text-xl sm:text-2xl font-bold tracking-tight">
                            Formularios avanzados
                        </h3>
                        <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                            Soporta lógica condicional compleja, restricciones
                            de validación personalizadas, GPS con precisión
                            satelital, firmas digitales y captura de archivos
                            multimedia.
                        </p>
                    </div>
                </div>

                <!-- CARD 4: Gestión sencilla -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-8 flex flex-col sm:flex-row gap-6 items-start sm:items-center hover:-translate-y-1 transition-transform duration-200">
                    <div class="w-24 h-24 rounded-2xl bg-primary-light border-2 border-ink shrink-0 flex items-center justify-center relative">
                        <FiClipboard
                            className="w-10 h-10 text-ink"
                            strokeWidth={2}
                        />
                        <span class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded-full bg-primary border border-ink text-[10px] font-mono font-bold text-ink">
                            SYNC
                        </span>
                    </div>

                    <div class="flex flex-col gap-2">
                        <h3 class="text-ink font-display text-xl sm:text-2xl font-bold tracking-tight">
                            Gestión sencilla
                        </h3>
                        <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                            Descarga múltiples cuestionarios correspondientes a
                            diferentes investigaciones y gestiona el historial
                            de envíos de forma transparente y sin límites.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Guía de Uso Rápido (Main Canvas) -->
    <section class="w-full py-16 lg:py-24 bg-canvas flex flex-col items-center">
        <div class="max-w-250 w-full mx-auto px-4 sm:px-6">
            <!-- Encabezado de la sección -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <Badge variant="primary" class="mb-4">
                    Guía de Campo
                </Badge>
                <h2 class="text-ink font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] leading-tight">
                    Flujo de Trabajo del{" "}
                    <TextReveal variant="light">Encuestador</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base sm:text-lg mt-4 font-medium leading-relaxed">
                    Un proceso metódico de 5 pasos para garantizar que tus datos
                    se capturen sin fallas técnicas en terreno.
                </p>
            </div>

            <!-- Bento Stack de Pasos -->
            <div class="flex flex-col gap-5">
                <!-- PASO 1 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-primary text-ink border-2 border-ink font-mono font-extrabold text-base flex items-center justify-center shrink-0">
                            01
                        </div>
                        <div>
                            <h3 class="text-ink font-display text-lg sm:text-xl font-bold tracking-tight">
                                Instala la aplicación
                            </h3>
                            <p class="text-text-muted font-sans text-sm font-medium mt-1">
                                Obtén el paquete oficial de DATAUMSA Collect
                                (.apk) e instálalo en cualquier teléfono
                                Android.
                            </p>
                        </div>
                    </div>
                    <div class="bg-canvas border-2 border-ink rounded-xl px-4 py-2 flex items-center gap-2 text-xs font-mono font-bold text-ink shrink-0">
                        <FiPlay className="text-success" /> Android 8.0+
                    </div>
                </div>

                <!-- PASO 2 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-primary-light text-ink border-2 border-ink font-mono font-extrabold text-base flex items-center justify-center shrink-0">
                            02
                        </div>
                        <div>
                            <h3 class="text-ink font-display text-lg sm:text-xl font-bold tracking-tight">
                                Inicia sesión institucional
                            </h3>
                            <p class="text-text-muted font-sans text-sm font-medium mt-1">
                                Ingresa tus credenciales asignadas por el
                                responsable del proyecto universitario.
                            </p>
                        </div>
                    </div>
                    <div class="bg-canvas border-2 border-ink rounded-xl px-4 py-2 flex items-center gap-2 text-xs font-mono font-bold text-ink shrink-0">
                        <FiLock className="text-primary" /> Autenticación UMSA
                    </div>
                </div>

                <!-- PASO 3 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-primary-light text-ink border-2 border-ink font-mono font-extrabold text-base flex items-center justify-center shrink-0">
                            03
                        </div>
                        <div>
                            <h3 class="text-ink font-display text-lg sm:text-xl font-bold tracking-tight">
                                Descarga tus cuestionarios
                            </h3>
                            <p class="text-text-muted font-sans text-sm font-medium mt-1">
                                Sincroniza los formularios a la memoria del
                                teléfono mientras tengas conexión Wi-Fi.
                            </p>
                        </div>
                    </div>
                    <div class="bg-canvas border-2 border-ink rounded-xl px-4 py-2 flex items-center gap-2 text-xs font-mono font-bold text-ink shrink-0">
                        <FiDownload className="text-accent" /> XLSForm en caché
                    </div>
                </div>

                <!-- PASO 4 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-primary-light text-ink border-2 border-ink font-mono font-extrabold text-base flex items-center justify-center shrink-0">
                            04
                        </div>
                        <div>
                            <h3 class="text-ink font-display text-lg sm:text-xl font-bold tracking-tight">
                                Recolecta en campo (Offline)
                            </h3>
                            <p class="text-text-muted font-sans text-sm font-medium mt-1">
                                Realiza las entrevistas en comunidades rurales
                                sin necesidad de señal o cobertura móvil.
                            </p>
                        </div>
                    </div>
                    <div class="bg-canvas border-2 border-ink rounded-xl px-4 py-2 flex items-center gap-2 text-xs font-mono font-bold text-ink shrink-0">
                        <FiWifiOff className="text-warning" /> 100% Sin Internet
                    </div>
                </div>

                <!-- PASO 5 -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-success text-ink border-2 border-ink font-mono font-extrabold text-base flex items-center justify-center shrink-0">
                            05
                        </div>
                        <div>
                            <h3 class="text-ink font-display text-lg sm:text-xl font-bold tracking-tight">
                                Sincroniza automáticamente
                            </h3>
                            <p class="text-text-muted font-sans text-sm font-medium mt-1">
                                Al reconectarte a la red, la aplicación envía
                                los registros cifrados al servidor central UMSA.
                            </p>
                        </div>
                    </div>
                    <div class="bg-canvas border-2 border-ink rounded-xl px-4 py-2 flex items-center gap-2 text-xs font-mono font-bold text-success shrink-0">
                        <FiRefreshCw /> Sincronización Lista
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. Call to Action Final (Midnight Band) -->
    <section class="w-full py-16 lg:py-24 bg-midnight text-white border-t-[2.5px] border-ink flex justify-center">
        <div class="max-w-250 w-full mx-4 sm:mx-6 text-center bg-midnight-surface border-3 border-ink rounded-[2.5rem] p-8 md:p-14 relative z-10 flex flex-col items-center">
            <Badge variant="primary" class="mb-4">
                Listo Para el Terreno
            </Badge>
            <h2 class="text-white font-display text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-[-0.035em] leading-tight mb-4">
                ¿Listo para llevar tu recolección de datos al campo?
            </h2>
            <p class="text-text-dark-muted font-sans text-base sm:text-lg max-w-xl font-medium leading-relaxed mb-8">
                Descarga la aplicación oficial en tu teléfono inteligente
                Android y comienza a registrar datos validados sin necesidad de
                señal.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <Button
                    href="/app-movil/descargas"
                    variant="bento-primary"
                    class="text-sm py-3 px-6"
                >
                    <FiDownload className="w-4 h-4 mr-1.5" />
                    <span>Ir al Centro de Descargas</span>
                </Button>
                <Button
                    href="/la-plataforma/casos-de-uso"
                    variant="bento-secondary"
                    class="text-sm py-3 px-6"
                >
                    <span>Ver Casos de Uso</span>
                </Button>
            </div>
        </div>
    </section>
</Layout>
