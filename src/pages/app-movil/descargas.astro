---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/components-astro/Badge.astro";
import TextReveal from "../../components/components-astro/TextReveal.astro";
import {
    FiDownload,
    FiSmartphone,
    FiDatabase,
    FiCheck,
    FiCheckCircle,
    FiShield,
    FiLock,
    FiServer,
    FiMapPin,
    FiCpu,
    FiClock,
    FiAward,
    FiLayers,
} from "react-icons/fi";
---

<Layout
    title="Descarga DATAUMSA Collect | Aplicación Móvil"
    description="Descarga la aplicación oficial DATAUMSA Collect para recolectar datos en campo de forma offline en dispositivos Android."
>
    <!-- 1. Split Hero Section (Main Canvas) -->
    <section class="w-full py-16 md:py-24 bg-canvas flex flex-col items-center">
        <div class="max-w-300 w-full mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
            <!-- Columna Izquierda: Información de Descarga -->
            <div class="lg:col-span-7 flex flex-col justify-center">
                <div class="flex flex-wrap items-center gap-2.5 mb-5">
                    <Badge variant="primary">Distribución Oficial UMSA</Badge>
                    <span class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-white text-ink border border-ink">
                        Versión 4.1
                    </span>
                </div>

                <h1 class="text-ink font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] leading-[1.08] mb-5">
                    Lleva la recolección <br />
                    <TextReveal variant="light">
                        a tu dispositivo Android
                    </TextReveal>
                </h1>

                <p class="text-text-muted font-sans text-base sm:text-lg leading-relaxed mb-8 max-w-xl font-medium">
                    Instala la aplicación oficial{" "}
                    <strong class="text-ink font-bold">DATAUMSA Collect</strong>{" "}
                    en tu teléfono o tableta. Diseñada para la comunidad
                    universitaria y los equipos de investigación, permitiendo
                    trabajar de forma continua incluso sin conexión a internet.
                </p>

                <!-- Tarjeta de Descarga Directa e Institucionalización -->
                <div class="flex flex-col gap-4 max-w-xl">
                    <!-- Botón Bento de Descarga Directa Principal -->
                    <a
                        href="/apk/DATA-UMSA-Collect-release-4.1.apk"
                        download="DATA-UMSA-Collect-release-4.1.apk"
                        class="bg-midnight-surface hover:bg-midnight text-white rounded-card p-5 sm:p-6 flex items-center gap-4 border-[2.5px] border-ink hover:-translate-y-1 active:translate-y-0.5 transition-transform duration-200 select-none group/download"
                    >
                        <div class="w-12 h-12 rounded-2xl bg-primary border-2 border-ink flex items-center justify-center shrink-0 text-ink">
                            <FiDownload
                                className="w-6 h-6 group-hover/download:translate-y-0.5 transition-transform"
                                strokeWidth={2.5}
                            />
                        </div>
                        <div class="flex flex-col items-start leading-tight">
                            <span class="text-[11px] font-bold tracking-widest text-primary font-mono uppercase">
                                Archivo de Instalación Directa
                            </span>
                            <span class="text-base sm:text-lg font-bold font-display tracking-tight text-white mt-0.5">
                                Descargar DATAUMSA Collect (.apk)
                            </span>
                            <span class="text-xs text-text-dark-muted font-mono mt-1">
                                8.9 MB • Compatible con Android 8.0 o superior
                            </span>
                        </div>
                    </a>

                    <!-- Aviso de Institucionalización UMSA -->
                    <div class="p-4 rounded-2xl bg-white border-2 border-ink flex items-start gap-3.5">
                        <div class="w-8 h-8 rounded-xl bg-warning border border-ink flex items-center justify-center text-ink shrink-0 mt-0.5 font-bold">
                            <FiAward className="w-4 h-4" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-xs font-bold text-ink uppercase tracking-wider font-mono flex items-center gap-1.5">
                                Proceso de Institucionalización UMSA
                                <span class="inline-block w-2 h-2 rounded-full bg-warning border border-ink"></span>
                            </span>
                            <p class="text-xs text-text-muted leading-relaxed font-sans font-medium">
                                La plataforma se encuentra en proceso de
                                formalización e institucionalización en la{" "}
                                <strong class="text-ink">
                                    Universidad Mayor de San Andrés
                                </strong>
                                . Una vez concluida esta etapa, la aplicación
                                estará disponible en la{" "}
                                <strong class="text-ink">
                                    Google Play Store
                                </strong>
                                . Por el momento, puede instalarse de manera
                                directa y segura mediante este archivo oficial.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Mockup del Smartphone Bento -->
            <div class="lg:col-span-5 flex items-center justify-center relative">
                <div class="w-75 rounded-[2.5rem] border-[3.5px] border-ink bg-midnight-surface p-5 relative overflow-hidden flex flex-col justify-between select-none text-white">
                    <!-- Notch del Teléfono -->
                    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-28 h-5 bg-midnight border-b-2 border-x-2 border-ink rounded-b-xl z-20 flex items-center justify-center">
                        <div class="w-10 h-1 bg-white/40 rounded-full mb-0.5"></div>
                    </div>

                    <!-- App Bar Superior -->
                    <div class="pt-4 flex items-center justify-between border-b-2 border-ink pb-3 mb-3">
                        <div class="flex items-center gap-2">
                            <div class="w-6 h-6 rounded-lg bg-primary border border-ink flex items-center justify-center text-ink">
                                <FiDatabase className="w-3.5 h-3.5" />
                            </div>
                            <span class="text-xs font-bold text-white font-display">
                                DATAUMSA Collect
                            </span>
                        </div>
                        <span class="text-[10px] font-mono font-bold text-ink bg-success border border-ink px-2 py-0.5 rounded-full flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-ink"></span>
                            Offline
                        </span>
                    </div>

                    <!-- Pantalla Principal de la App -->
                    <div class="grow py-2 flex flex-col gap-3 overflow-hidden">
                        <!-- Perfil / Usuario Institucional -->
                        <div class="p-3 rounded-xl bg-midnight border-2 border-ink flex items-center justify-between">
                            <div class="flex flex-col">
                                <span class="text-[10px] font-mono uppercase text-text-dark-muted tracking-wider font-bold">
                                    Cuenta Institucional
                                </span>
                                <span class="text-xs font-bold text-white font-display">
                                    investigador@umsa.bo
                                </span>
                            </div>
                            <div class="px-2 py-0.5 rounded-md bg-primary border border-ink text-ink text-[10px] font-mono font-bold">
                                UMSA
                            </div>
                        </div>

                        <!-- Card de Proyecto Activo -->
                        <div class="p-3 rounded-xl bg-midnight border-2 border-ink flex flex-col gap-1.5 relative overflow-hidden">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-primary font-mono">
                                    Proyecto Activo
                                </span>
                                <span class="text-[10px] text-text-dark-muted font-mono font-bold">
                                    v4.1
                                </span>
                            </div>
                            <span class="text-xs font-bold text-white font-display leading-tight">
                                Relevamiento Socioeconómico y Ambiental 2026
                            </span>
                            <div class="flex items-center gap-1.5 text-[10px] text-text-dark-muted pt-1 border-t border-ink">
                                <FiMapPin className="w-3 h-3 text-primary shrink-0" />
                                <span class="font-mono">
                                    La Paz, Bolivia (GPS Activo)
                                </span>
                            </div>
                        </div>

                        <!-- Fila de Formularios Listos -->
                        <div class="flex flex-col gap-2">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-text-dark-muted font-mono">
                                Formularios Disponibles
                            </span>

                            <div class="p-2 rounded-xl bg-midnight border-2 border-ink flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="w-5 h-5 rounded-lg bg-success border border-ink flex items-center justify-center text-ink">
                                        <FiCheck
                                            className="w-3 h-3"
                                            strokeWidth={3}
                                        />
                                    </div>
                                    <span class="text-xs font-bold text-white">
                                        Ficha_Comunal_v2.xml
                                    </span>
                                </div>
                                <span class="text-[10px] font-mono text-success font-bold">
                                    Disponible
                                </span>
                            </div>

                            <div class="p-2 rounded-xl bg-midnight border-2 border-ink flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="w-5 h-5 rounded-lg bg-primary border border-ink flex items-center justify-center text-ink">
                                        <FiLayers className="w-3 h-3" />
                                    </div>
                                    <span class="text-xs font-bold text-white">
                                        Muestreo_Agua_pH.xml
                                    </span>
                                </div>
                                <span class="text-[10px] font-mono text-primary font-bold">
                                    Sincronizado
                                </span>
                            </div>
                        </div>

                        <!-- Botón Acción dentro de la App -->
                        <div class="mt-auto flex flex-col gap-1.5">
                            <div class="w-full bg-primary border-2 border-ink text-ink rounded-full py-2 px-3 flex items-center justify-between text-xs font-bold uppercase tracking-wider">
                                <span>Iniciar Nuevo Formulario</span>
                                <span class="text-sm font-bold">→</span>
                            </div>
                            <div class="flex items-center justify-between px-1 text-[10px] text-text-dark-muted font-mono">
                                <span class="flex items-center gap-1">
                                    <FiLock className="w-2.5 h-2.5 text-primary" />{" "}
                                    Almacenamiento Cifrado
                                </span>
                                <span>Servidor UMSA</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Requisitos y Compatibilidad (Cyan Light Band) -->
    <section class="w-full py-16 lg:py-24 bg-primary-light border-y-[2.5px] border-ink flex flex-col items-center">
        <div class="max-w-300 w-full mx-auto px-4 sm:px-6">
            <!-- Encabezado de la Sección -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <Badge variant="primary" class="mb-4">
                    Requisitos y Características
                </Badge>
                <h2 class="text-ink font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] leading-tight">
                    Diseñada para el{" "}
                    <TextReveal variant="light">trabajo de campo</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base sm:text-lg mt-4 font-medium leading-relaxed">
                    Optimizada para garantizar una recolección de información
                    continua y confiable en cualquier región del país.
                </p>
            </div>

            <!-- Bento Grid 1x2: 7 Columnas + 5 Columnas -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
                <!-- Columna Izquierda: Tarjeta Principal (Requisitos y Compatibilidad) -->
                <div class="lg:col-span-7 bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-9 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex flex-col gap-6">
                        <!-- Cabecera de la Tarjeta con Badges -->
                        <div class="flex items-center justify-between flex-wrap gap-2">
                            <span class="text-xs font-mono font-bold uppercase tracking-wider text-ink bg-primary-light border border-ink px-3 py-1 rounded-full flex items-center gap-1.5">
                                <FiCpu className="w-3.5 h-3.5" /> Compatibilidad
                                de Sistema
                            </span>
                            <span class="text-xs font-mono font-bold text-ink bg-success px-2.5 py-0.5 rounded-full border border-ink">
                                Soporte Android Actualizado
                            </span>
                        </div>

                        <!-- Indicadores Visuales de Recursos y Versión -->
                        <div class="w-full rounded-2xl bg-midnight-surface border-2 border-ink p-5 flex flex-col gap-4 text-white font-mono">
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-text-dark-muted flex items-center gap-2">
                                    <FiSmartphone className="w-4 h-4 text-primary" />{" "}
                                    SISTEMA OPERATIVO
                                </span>
                                <span class="text-ink font-bold bg-success border border-ink px-2 py-0.5 rounded">
                                    Android 8.0 en adelante
                                </span>
                            </div>
                            <!-- Barra de compatibilidad visual -->
                            <div class="w-full h-3 rounded-full bg-midnight border border-ink overflow-hidden">
                                <div class="w-[96%] h-full bg-primary rounded-full"></div>
                            </div>
                            <div class="grid grid-cols-2 gap-4 pt-3 border-t border-ink text-xs">
                                <div class="flex flex-col">
                                    <span class="text-text-dark-muted text-[10px]">
                                        CONSUMO DE MEMORIA
                                    </span>
                                    <span class="text-primary font-bold text-sm">
                                        Bajo uso de recursos
                                    </span>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-success font-bold text-sm">
                                        8.9 MB (Instalador completo)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Título y Descripción -->
                        <div class="flex flex-col gap-2">
                            <h3 class="text-ink font-display text-2xl font-bold tracking-tight">
                                Compatibilidad y Requisitos de Hardware
                            </h3>
                            <p class="text-text-muted font-sans text-sm sm:text-base leading-relaxed font-medium">
                                Desarrollada para operar de manera estable en
                                una amplia variedad de modelos, facilitando el
                                trabajo tanto en teléfonos modernos como en
                                dispositivos de campo compatibles con versiones
                                recientes.
                            </p>
                        </div>
                    </div>

                    <!-- Ficha Técnica 2x2 en la Base -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-6 mt-6 border-t-2 border-ink">
                        <div class="p-3.5 rounded-2xl bg-canvas border-2 border-ink flex flex-col">
                            <span class="text-[11px] font-bold text-text-muted uppercase font-mono">
                                Versión Mínima
                            </span>
                            <span class="text-sm font-bold text-ink">
                                Android 8.0 (Oreo)
                            </span>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-primary-light border-2 border-ink flex flex-col">
                            <span class="text-[11px] font-bold text-primary-dark uppercase font-mono">
                                Versión Recomendada
                            </span>
                            <span class="text-sm font-bold text-ink">
                                Android 10 o superior
                            </span>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-canvas border-2 border-ink flex flex-col">
                            <span class="text-[11px] font-bold text-text-muted uppercase font-mono">
                                Memoria RAM
                            </span>
                            <span class="text-sm font-bold text-ink">
                                2 GB mín. (4 GB recomendada)
                            </span>
                        </div>
                        <div class="p-3.5 rounded-2xl bg-canvas border-2 border-ink flex flex-col">
                            <span class="text-[11px] font-bold text-text-muted uppercase font-mono">
                                Modo de Operación
                            </span>
                            <span class="text-sm font-bold text-ink">
                                Autónomo (100% offline)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: 2 Tarjetas Apiladas -->
                <div class="lg:col-span-5 flex flex-col gap-6 lg:gap-8 justify-between">
                    <!-- Tarjeta 2: Ubicación Geográfica y Privacidad -->
                    <div class="bg-white border-[2.5px] border-ink rounded-card p-7 flex-1 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                        <div class="flex flex-col gap-4">
                            <!-- Visual de Sensores y Ubicación -->
                            <div class="w-full rounded-2xl bg-midnight-surface border-2 border-ink p-4 flex items-center justify-between text-white font-mono">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-xl bg-primary border border-ink flex items-center justify-center text-ink">
                                        <FiMapPin className="w-4 h-4" />
                                    </div>
                                    <span class="text-xs font-bold text-white">
                                        Sensor GPS Satelital
                                    </span>
                                </div>
                                <span class="text-[10px] text-ink font-bold px-2 py-0.5 rounded-full bg-success border border-ink">
                                    Offline Activo
                                </span>
                            </div>

                            <div class="flex flex-col gap-2">
                                <h3 class="text-ink font-display text-xl font-bold tracking-tight">
                                    Ubicación Geográfica y Privacidad
                                </h3>
                                <p class="text-text-muted font-sans text-sm leading-relaxed font-medium">
                                    La aplicación solicita únicamente los
                                    permisos indispensables para la recolección
                                    de datos en campo. No contiene publicidad
                                    comercial ni recopila datos personales
                                    ajenos al proyecto.
                                </p>
                            </div>
                        </div>

                        <ul class="space-y-2 text-xs text-ink font-bold pt-4 mt-4 border-t-2 border-ink">
                            <li class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded-full bg-success border border-ink flex items-center justify-center text-ink">
                                    <FiCheck
                                        className="w-3 h-3"
                                        strokeWidth={3}
                                    />
                                </div>
                                Registro de coordenadas y polígonos
                            </li>
                            <li class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded-full bg-success border border-ink flex items-center justify-center text-ink">
                                    <FiCheck
                                        className="w-3 h-3"
                                        strokeWidth={3}
                                    />
                                </div>
                                Captura de fotografías en calidad original
                            </li>
                        </ul>
                    </div>

                    <!-- Tarjeta 3: Seguridad y Respaldo Institucional -->
                    <div class="bg-white border-[2.5px] border-ink rounded-card p-7 flex-1 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                        <div class="flex flex-col gap-4">
                            <!-- Visual de Servidor y Cifrado -->
                            <div class="w-full rounded-2xl bg-midnight-surface border-2 border-ink p-4 flex items-center justify-around text-white font-mono">
                                <div class="flex items-center gap-1.5">
                                    <FiSmartphone className="w-3.5 h-3.5 text-primary" />
                                    <span class="text-[10px] text-text-dark-muted">
                                        Móvil
                                    </span>
                                </div>
                                <div class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary border border-ink text-ink text-[10px] font-bold">
                                    <FiLock className="w-3 h-3" /> Seguro
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <FiServer className="w-3.5 h-3.5 text-primary" />
                                    <span class="text-[10px] text-text-dark-muted">
                                        UMSA
                                    </span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-2">
                                <h3 class="text-ink font-display text-xl font-bold tracking-tight">
                                    Seguridad y Respaldo Institucional
                                </h3>
                                <p class="text-text-muted font-sans text-sm leading-relaxed font-medium">
                                    La información recolectada se transmite de
                                    forma directa a los servidores centrales de
                                    la Universidad Mayor de San Andrés,
                                    garantizando el resguardo y la custodia
                                    académica de los datos.
                                </p>
                            </div>
                        </div>

                        <ul class="space-y-2 text-xs text-ink font-bold pt-4 mt-4 border-t-2 border-ink">
                            <li class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded-full bg-success border border-ink flex items-center justify-center text-ink">
                                    <FiCheck
                                        className="w-3 h-3"
                                        strokeWidth={3}
                                    />
                                </div>
                                Almacenamiento en datacenter universitario
                            </li>
                            <li class="flex items-center gap-2">
                                <div class="w-4 h-4 rounded-full bg-success border border-ink flex items-center justify-center text-ink">
                                    <FiCheck
                                        className="w-3 h-3"
                                        strokeWidth={3}
                                    />
                                </div>
                                Transmisión por canales cifrados SSL/TLS
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Guía de Instalación de la Aplicación (Main Canvas) -->
    <section class="w-full py-16 lg:py-24 bg-canvas flex flex-col items-center">
        <div class="max-w-300 w-full mx-auto px-4 sm:px-6">
            <!-- Encabezado de la sección -->
            <div class="text-center max-w-2xl mx-auto mb-16">
                <Badge variant="primary" class="mb-4">
                    Guía de Instalación
                </Badge>
                <h2 class="text-ink font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] leading-tight">
                    ¿Cómo instalar la aplicación{" "}
                    <TextReveal variant="light">en su dispositivo?</TextReveal>
                </h2>
                <p class="text-text-muted font-sans text-base sm:text-lg mt-4 font-medium leading-relaxed">
                    Siga estos tres sencillos pasos para instalar y comenzar a
                    utilizar la aplicación en su teléfono o tableta.
                </p>
            </div>

            <!-- Grid de 3 Pasos Reales para APK -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
                <!-- Paso 1: Descargar -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex flex-col gap-5">
                        <div class="w-full h-24 rounded-2xl bg-midnight-surface border-2 border-ink flex flex-col justify-between p-4 relative overflow-hidden">
                            <div class="flex justify-between items-center text-xs font-mono text-text-dark-muted">
                                <span class="text-primary font-bold flex items-center gap-1.5">
                                    <FiDownload className="w-3.5 h-3.5" />{" "}
                                    DESCARGA DIRECTA
                                </span>
                                <span class="text-white font-bold">8.9 MB</span>
                            </div>
                            <div class="w-full h-2 rounded-full bg-midnight border border-ink overflow-hidden">
                                <div class="h-full bg-primary rounded-full w-full"></div>
                            </div>
                            <span class="text-[10px] text-text-dark-muted font-mono">
                                DATA-UMSA-Collect-release-4.1.apk
                            </span>
                        </div>

                        <div class="flex flex-col gap-2">
                            <div class="w-9 h-9 rounded-xl bg-primary text-ink border-2 border-ink font-mono font-extrabold text-sm flex items-center justify-center">
                                1
                            </div>
                            <h3 class="text-ink font-display text-lg font-bold tracking-tight">
                                Descargar el archivo
                            </h3>
                            <p class="text-text-muted font-sans text-sm leading-relaxed font-medium">
                                Presione el botón de descarga en esta página
                                para obtener el archivo oficial de instalación (
                                <strong class="text-ink">.apk</strong>) en su
                                dispositivo.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Paso 2: Permitir Origen Seguro -->
                <div class="bg-white border-[2.5px] border-ink rounded-card p-7 flex flex-col justify-between hover:-translate-y-1 transition-transform duration-200">
                    <div class="flex flex-col gap-5">
