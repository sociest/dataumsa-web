---
import { FiBookOpen, FiClipboard, FiGlobe, FiArrowRight } from "react-icons/fi";
import Badge from "./Badge.astro";

const cases = [
    {
        id: "01",
        shortTitle: "Tesis & Proyectos",
        title: "Investigación y Tesis",
        desc: "Diseña formularios con lógicas de salto complejas. Exporta tu data limpia y lista para SPSS o Stata, ahorrando semanas de tabulación manual.",
        icon: FiBookOpen,
        color: "text-accent",
        bg: "bg-white",
        cardBg: "bg-white",
        badgeBg: "bg-accent/15",
        href: "/la-plataforma/casos-de-uso#tesis",
    },
    {
        id: "02",
        shortTitle: "Prácticas de Campo",
        title: "Docencia y Trabajo de Campo",
        desc: "Lleva a tus estudiantes a zonas sin cobertura. La app dedicada garantiza recolección 100% offline y sincronización en bloque al recuperar la señal.",
        icon: FiClipboard,
        color: "text-primary-dark",
        bg: "bg-primary-light",
        cardBg: "bg-primary-light",
        badgeBg: "bg-white",
        href: "/la-plataforma/casos-de-uso#docencia",
    },
    {
        id: "03",
        shortTitle: "Censos & Operativos",
        title: "Operativos a Gran Escala",
        desc: "Probada en el Censo Universitario: más de 65.000 estudiantes censados con un 95% de autocenso digital autónomo y brigadas presenciales monitoreadas en tiempo real.",
        icon: FiGlobe,
        color: "text-success",
        bg: "bg-white",
        cardBg: "bg-white",
        badgeBg: "bg-success/15",
        href: "/la-plataforma/casos-de-uso#censos",
    },
];
---

<section class="w-full py-16 lg:py-24 px-4 sm:px-6 bg-canvas">
    <div class="max-w-300 w-full mx-auto">
        <!-- Encabezado -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="max-w-xl">
                <Badge variant="primary" class="mb-4 inline-flex">
                    Alcance del Sistema
                </Badge>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] text-ink font-display leading-tight">
                    Escalabilidad <span class="text-primary">real.</span>
                </h2>
            </div>
            <p class="text-text-muted text-base sm:text-lg font-medium max-w-sm md:text-right font-sans">
                Explora cómo la plataforma se adapta a los distintos niveles de
                investigación académica.
            </p>
        </div>

        <!-- Contenedor del Acordeón Elástico Bento -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:flex lg:flex-row w-full gap-4 lg:gap-6 lg:h-135">
            {cases.map((item) => (
                <a
                    href={item.href}
                    class={`group elastic-panel relative flex flex-col justify-between p-6 sm:p-8 lg:p-0 lg:flex-1 lg:hover:flex-[3.5] lg:focus-within:flex-[3.5] rounded-card border-[2.5px] border-ink ${item.cardBg} overflow-hidden cursor-pointer no-underline text-inherit transition-all duration-300`}
                >
                    <!-- VISTA DESKTOP: ESTADO CONTRAÍDO (Solo en lg+) -->
                    <div class="hidden lg:flex absolute inset-0 p-8 flex-col justify-between items-center z-20 transition-opacity duration-300 group-hover:opacity-0 group-hover:pointer-events-none">
                        <!-- Icono -->
                        <div class="w-14 h-14 rounded-2xl bg-white border-2 border-ink flex items-center justify-center">
                            <item.icon
                                className="w-6 h-6 text-ink"
                                strokeWidth={2.5}
                            />
                        </div>

                        <!-- Título Vertical -->
                        <h3 class="font-extrabold text-xl tracking-wider text-ink uppercase whitespace-nowrap [writing-mode:vertical-lr] rotate-180 font-display">
                            {item.shortTitle}
                        </h3>

                        <span class="font-mono text-ink font-bold text-sm bg-white px-2.5 py-1 rounded-full border border-ink">
                            {item.id}
                        </span>
                    </div>

                    <!-- VISTA DESKTOP: ESTADO EXPANDIDO (Solo en lg+) -->
                    <div class="hidden lg:flex absolute inset-0 p-10 flex-col justify-end z-30 opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-6 group-hover:translate-y-0 pointer-events-none group-hover:pointer-events-auto">
                        <div class="w-full min-w-95 max-w-lg">
                            <div
                                class={`w-16 h-16 rounded-2xl ${item.badgeBg} border-2 border-ink flex items-center justify-center mb-6`}
                            >
                                <item.icon
                                    className="w-8 h-8 text-ink"
                                    strokeWidth={2.5}
                                />
                            </div>

                            <h3 class="text-3xl lg:text-4xl font-extrabold text-ink mb-4 leading-tight font-display tracking-tight">
                                {item.title}
                            </h3>

                            <p class="text-text-muted font-medium text-base lg:text-lg leading-relaxed mb-6 font-sans">
                                {item.desc}
                            </p>

                            <div class="inline-flex items-center gap-2.5 font-bold text-sm uppercase tracking-wider text-ink bg-white border-2 border-ink py-2.5 px-5 rounded-full hover:bg-primary transition-colors duration-200">
                                <span>Ver especificaciones</span>
                                <FiArrowRight className="w-4 h-4" />
                            </div>
                        </div>
                    </div>

                    <!-- VISTA MÓVIL Y TABLET (< lg) -->
                    <div class="lg:hidden flex flex-col justify-between h-full z-20 gap-6">
                        <div class="flex items-start justify-between">
                            <div
                                class={`w-14 h-14 rounded-2xl ${item.badgeBg} border-2 border-ink flex items-center justify-center`}
                            >
                                <item.icon
                                    className="w-7 h-7 text-ink"
                                    strokeWidth={2.5}
                                />
                            </div>
                            <span class="font-mono text-ink font-bold text-sm bg-white px-2.5 py-1 rounded-full border border-ink">
                                {item.id}
                            </span>
                        </div>
                        <div>
                            <h3 class="text-2xl font-extrabold text-ink mb-2 leading-tight font-display tracking-tight">
                                {item.title}
                            </h3>
                            <p class="text-text-muted font-normal text-base leading-relaxed font-sans">
                                {item.desc}
                            </p>
                        </div>
                        <div class="inline-flex items-center gap-2 font-bold text-xs uppercase tracking-wider text-ink bg-white border-2 border-ink py-2 px-4 rounded-full max-w-max">
                            <span>Ver especificaciones</span>
                            <FiArrowRight className="w-4 h-4" />
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>

<style>
    .elastic-panel {
        transition:
            flex 0.6s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.2s ease;
        will-change: flex;
    }
</style>
