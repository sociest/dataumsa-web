---
// Componente Hero Bento Grid para DATAUMSA (Adaptado a Bento DESIGN2.md)
import Button from "./Button.astro";
import Badge from "./Badge.astro";
import TextReveal from "./TextReveal.astro";
---

<section class="w-full bg-canvas py-8 lg:py-12 px-4 sm:px-6">
    <div class="max-w-300 w-full mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 animate-fade-in">
        {/* Tarjeta Principal (2x2) */}
        <div class="lg:col-span-2 lg:row-span-2 bg-midnight-surface rounded-card p-8 lg:p-12 relative overflow-hidden flex flex-col justify-between group border-[2.5px] border-ink hover:-translate-y-1 transition-transform duration-200">
            {/* Fondo sutil de grilla geométrica */}
            <div
                class="absolute inset-0 opacity-[0.04]"
                style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 20px 20px;"
            ></div>

            <div class="relative z-10 space-y-6">
                <Badge variant="dark" dotColor="bg-primary">
                    Plataforma oficial de recolección UMSA
                </Badge>

                <div class="space-y-3">
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] text-white leading-[1.08] font-display">
                        <TextReveal variant="light">DATAUMSA</TextReveal>
                    </h1>
                    <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold leading-snug text-white/90 tracking-[-0.02em] font-display">
                        Investigación y{" "}
                        <span class="text-primary">recolección de datos</span>{" "}
                        avanzada.
                    </h2>
                </div>

                <p class="text-base sm:text-lg text-text-dark-muted leading-relaxed max-w-md font-sans">
                    Herramientas profesionales, soberanía total de tu
                    información y trabajo{" "}
                    <span class="font-bold text-white">100% offline</span>.
                    Diseñada por y para la comunidad.
                </p>
            </div>

            <div class="relative z-10 flex flex-wrap gap-3.5 mt-8 pt-4">
                <Button
                    href="https://app-dataumsa.sociest.org/accounts/login/"
                    variant="bento-primary"
                    target="_blank"
                >
                    Acceder a la Plataforma
                </Button>
                <Button
                    href="/la-plataforma/caracteristicas"
                    variant="bento-secondary"
                >
                    Explorar Características
                </Button>
            </div>
        </div>

        {/* Tarjeta 1: Formularios (White Plate) */}
        <a
            href="/la-plataforma/caracteristicas#formularios"
            class="bg-white rounded-card p-6 lg:p-7 flex flex-col justify-between border-[2.5px] border-ink hover:-translate-y-1 active:translate-y-0.5 transition-transform duration-200 relative overflow-hidden group no-underline text-inherit"
        >
            {/* Micro-indicador sticker interactivo */}
            <div class="flex justify-end w-full relative z-10">
                <div class="w-8 h-8 rounded-full border-2 border-ink bg-canvas flex items-center justify-center text-ink group-hover:bg-primary transition-colors duration-200">
                    <svg
                        class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M7 17L17 7M17 7H7M17 7V17"
                        ></path>
                    </svg>
                </div>
            </div>

            {/* Sticker Asset: Formulario */}
            <div class="w-20 h-20 my-3 relative z-10">
                <div class="absolute inset-0 bg-primary-light rounded-2xl border-2 border-ink p-3 flex flex-col justify-center gap-2">
                    <div class="w-3/4 h-2 bg-primary rounded-full border border-ink/40"></div>
                    <div class="w-full h-2 bg-midnight/20 rounded-full"></div>
                    <div class="flex gap-2 items-center mt-0.5">
                        <div class="w-4 h-4 rounded-md bg-primary border-1.5 border-ink flex items-center justify-center">
                            <div class="w-1.5 h-2.5 border-b-2 border-r-2 border-ink transform rotate-45 -mt-0.5"></div>
                        </div>
                        <div class="w-3/5 h-2 bg-midnight/30 rounded-full"></div>
                    </div>
                </div>
            </div>

            <div class="relative z-10">
                <h4 class="text-lg font-extrabold text-ink mb-1 font-display tracking-tight">
                    Formularios complejos
                </h4>
                <p class="text-sm font-medium text-text-muted font-sans">
                    Lógica avanzada y saltos condicionales
                </p>
            </div>
        </a>

        {/* Tarjeta 2: Android App (Cyan Light Wash) */}
        <a
            href="/app-movil/dataumsa-collect"
            class="bg-primary-light rounded-card p-6 lg:p-7 flex flex-col justify-between border-[2.5px] border-ink hover:-translate-y-1 active:translate-y-0.5 transition-transform duration-200 relative overflow-hidden group no-underline text-inherit"
        >
            {/* Micro-indicador sticker interactivo */}
            <div class="flex justify-end w-full relative z-10">
                <div class="w-8 h-8 rounded-full border-2 border-ink bg-white flex items-center justify-center text-ink group-hover:bg-primary transition-colors duration-200">
                    <svg
                        class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M7 17L17 7M17 7H7M17 7V17"
                        ></path>
                    </svg>
                </div>
            </div>

            {/* Sticker Asset: App Offline */}
            <div class="w-20 h-20 my-3 relative z-10 flex items-center justify-center">
                <div class="relative w-14 h-20 border-2 border-ink rounded-[14px] bg-white p-1.5 flex flex-col items-center">
                    <div class="w-5 h-1 bg-ink rounded-full mb-1"></div>
                    <div class="w-full flex-1 bg-primary-light rounded border border-ink/30 flex flex-col gap-1.5 p-1">
                        <div class="w-full h-2 bg-primary rounded-xs"></div>
                        <div class="w-4/5 h-2 bg-midnight/20 rounded-xs"></div>
                        <div class="w-full h-2 bg-midnight/15 rounded-xs"></div>
                    </div>
                    {/* Offline Badge */}
                    <div class="absolute -right-2 top-4 w-5 h-5 bg-primary border-1.5 border-ink rounded-full flex items-center justify-center">
                        <div class="w-2.5 h-0.5 bg-ink rotate-45 absolute"></div>
                        <div class="w-2.5 h-0.5 bg-ink -rotate-45 absolute"></div>
                    </div>
                </div>
            </div>

            <div class="relative z-10">
                <h4 class="text-lg font-extrabold text-ink mb-1 font-display tracking-tight">
                    App Android dedicada
                </h4>
                <p class="text-sm font-medium text-text-muted font-sans">
                    Operación 100% offline garantizada
                </p>
            </div>
        </a>

        {/* Tarjeta 3: Análisis (Cyan Light Wash) */}
        <a
            href="/la-plataforma/caracteristicas#analisis"
            class="bg-primary-light rounded-card p-6 lg:p-7 flex flex-col justify-between border-[2.5px] border-ink hover:-translate-y-1 active:translate-y-0.5 transition-transform duration-200 relative overflow-hidden group no-underline text-inherit"
        >
            {/* Micro-indicador sticker interactivo */}
            <div class="flex justify-end w-full relative z-10">
                <div class="w-8 h-8 rounded-full border-2 border-ink bg-white flex items-center justify-center text-ink group-hover:bg-primary transition-colors duration-200">
                    <svg
                        class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M7 17L17 7M17 7H7M17 7V17"
                        ></path>
                    </svg>
                </div>
            </div>

            {/* Sticker Asset: Gráfico de barras ascendente */}
            <div class="w-20 h-20 my-3 relative z-10 flex items-end justify-between px-2 pb-2 border-b-2 border-ink bg-white/70 rounded-xl border border-ink/20">
                <div class="w-3.5 h-6 bg-primary/40 border border-ink rounded-t-sm group-hover:h-8 transition-all duration-300"></div>
                <div class="w-3.5 h-10 bg-primary/70 border border-ink rounded-t-sm group-hover:h-12 transition-all duration-300"></div>
                <div class="w-3.5 h-14 bg-primary border-1.5 border-ink rounded-t-sm group-hover:h-16 transition-all duration-300"></div>
            </div>

            <div class="relative z-10">
                <h4 class="text-lg font-extrabold text-ink mb-1 font-display tracking-tight">
                    Análisis profesional
                </h4>
                <p class="text-sm font-medium text-text-muted font-sans">
                    Exportación directa a SPSS y Stata
                </p>
            </div>
        </a>

        {/* Tarjeta 4: Soberanía (White Plate) */}
        <a
            href="/sobre-dataumsa/historia"
            class="bg-white rounded-card p-6 lg:p-7 flex flex-col justify-between border-[2.5px] border-ink hover:-translate-y-1 active:translate-y-0.5 transition-transform duration-200 relative overflow-hidden group no-underline text-inherit"
        >
            {/* Micro-indicador sticker interactivo */}
            <div class="flex justify-end w-full relative z-10">
                <div class="w-8 h-8 rounded-full border-2 border-ink bg-canvas flex items-center justify-center text-ink group-hover:bg-primary transition-colors duration-200">
                    <svg
                        class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M7 17L17 7M17 7H7M17 7V17"
                        ></path>
                    </svg>
                </div>
            </div>

            {/* Sticker Asset: Escudo / Nodo de Datos */}
            <div class="w-20 h-20 my-3 relative z-10 flex items-center justify-center">
                <div class="absolute inset-2 border-2 border-ink rounded-2xl rotate-45 group-hover:rotate-90 transition-transform duration-500 bg-primary-light"></div>
                <div class="w-7 h-7 bg-primary border-1.5 border-ink rounded-md rotate-45 flex items-center justify-center relative z-10">
                    <div class="w-2 h-2 bg-ink rounded-full"></div>
                </div>
            </div>

            <div class="relative z-10">
                <h4 class="text-lg font-extrabold text-ink mb-1 font-display tracking-tight">
                    Soberanía de datos
                </h4>
                <p class="text-sm font-medium text-text-muted font-sans">
                    Custodiados en Datacenter UMSA
                </p>
            </div>
        </a>
    </div>
</section>
