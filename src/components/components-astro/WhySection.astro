---
// Componente WhySection (¿Por qué elegir DATAUMSA?) - Adaptado a Bento DESIGN2.md (Cyan Light Band)
import Badge from "./Badge.astro";
import { FiShield, FiSliders, FiWifiOff, FiBarChart2 } from "react-icons/fi";
---

<section class="w-full bg-primary-light py-16 lg:py-24 px-4 sm:px-6 border-y-[2.5px] border-ink">
    <div class="max-w-300 w-full mx-auto">
        <!-- Encabezado de la sección -->
        <div class="text-center max-w-2xl mx-auto mb-16">
            <Badge variant="white" class="mb-4 inline-flex">
                Ventajas Clave
            </Badge>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink tracking-[-0.035em] font-display leading-tight">
                ¿Por qué elegir{" "}
                <span class="bg-primary px-2 py-0.5 rounded-lg border-2 border-ink">
                    DATAUMSA?
                </span>
            </h2>
            <p class="text-base sm:text-lg text-text-muted font-medium mt-4 font-sans max-w-xl mx-auto">
                Tecnología académica de estándar global adaptada a las
                necesidades reales de investigación.
            </p>
        </div>

        <!-- Bento Grid 2x2 de White Plates con bordes de tinta -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            <!-- CARD 1: SOBERANÍA -->
            <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-9 flex flex-col justify-between group hover:-translate-y-1 transition-transform duration-200">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center mb-6 group-hover:bg-primary transition-colors duration-200">
                        <FiShield className="w-7 h-7 text-ink" />
                    </div>
                    <h3 class="text-2xl font-bold text-ink mb-3 font-display tracking-tight">
                        Soberanía de datos
                    </h3>
                    <p class="text-text-muted font-medium leading-relaxed font-sans text-base">
                        Tus datos se quedan en servidores de la UMSA. Nunca se
                        venden ni se comparten con terceros corporativos.
                    </p>
                </div>
            </div>

            <!-- CARD 2: HERRAMIENTAS -->
            <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-9 flex flex-col justify-between group hover:-translate-y-1 transition-transform duration-200">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center mb-6 group-hover:bg-primary transition-colors duration-200">
                        <FiSliders className="w-7 h-7 text-ink" />
                    </div>
                    <h3 class="text-2xl font-bold text-ink mb-3 font-display tracking-tight">
                        Herramientas profesionales
                    </h3>
                    <p class="text-text-muted font-medium leading-relaxed font-sans text-base">
                        Lógica condicional compleja, grupos repetibles, cálculos
                        matemáticos, GPS y soporte multimedia completo.
                    </p>
                </div>
            </div>

            <!-- CARD 3: OFFLINE -->
            <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-9 flex flex-col justify-between group hover:-translate-y-1 transition-transform duration-200">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center mb-6 group-hover:bg-primary transition-colors duration-200">
                        <FiWifiOff className="w-7 h-7 text-ink" />
                    </div>
                    <h3 class="text-2xl font-bold text-ink mb-3 font-display tracking-tight">
                        Trabajo 100% offline
                    </h3>
                    <p class="text-text-muted font-medium leading-relaxed font-sans text-base">
                        Recolecta datos en cualquier lugar del país sin
                        necesidad de señal celular gracias a la app Android
                        dedicada.
                    </p>
                </div>
            </div>

            <!-- CARD 4: ANÁLISIS -->
            <div class="bg-white border-[2.5px] border-ink rounded-card p-7 sm:p-9 flex flex-col justify-between group hover:-translate-y-1 transition-transform duration-200">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-primary-light border-2 border-ink flex items-center justify-center mb-6 group-hover:bg-primary transition-colors duration-200">
                        <FiBarChart2 className="w-7 h-7 text-ink" />
                    </div>
                    <h3 class="text-2xl font-bold text-ink mb-3 font-display tracking-tight">
                        Análisis y exportación
                    </h3>
                    <p class="text-text-muted font-medium leading-relaxed font-sans text-base">
                        Exporta tus bases limpias en formatos estándar como
                        Excel, CSV, SPSS (.sav) y Stata (.dta) con un solo clic.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
