---
// Componente ComparativeSection (Google Forms vs DATAUMSA) - Adaptado a Bento DESIGN2.md
import { FiCheck, FiX } from "react-icons/fi";
import Badge from "./Badge.astro";

const comparativeData = [
    {
        feature: "Privacidad de los datos",
        google: {
            text: "Tus datos son el producto de big tech",
            supported: false,
        },
        umsa: {
            text: "Soberanía total (Datacenter UMSA)",
            supported: true,
        },
    },
    {
        feature: "Trabajo en campo sin internet",
        google: {
            text: "No soportado nativamente",
            supported: false,
        },
        umsa: {
            text: "100% Offline (App móvil dedicada)",
            supported: true,
        },
    },
    {
        feature: "Complejidad de formularios",
        google: {
            text: "Muy básico (Lógica lineal simple)",
            supported: false,
        },
        umsa: {
            text: "Estándar XLSForm (Saltos, matrices, GPS)",
            supported: true,
        },
    },
    {
        feature: "Análisis e investigación",
        google: {
            text: "Limitado a gráficos genéricos y sheets",
            supported: false,
        },
        umsa: {
            text: "Exportación directa a SPSS y Stata",
            supported: true,
        },
    },
];
---

<section class="w-full bg-midnight py-16 lg:py-24 px-4 sm:px-6 border-y-[2.5px] border-ink">
    <div class="max-w-300 w-full mx-auto">
        <!-- Encabezado de la sección -->
        <div class="text-center mb-14">
            <Badge variant="mono" class="mb-4 inline-flex">
                <span>Análisis Comparativo</span>
            </Badge>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] text-white font-display leading-tight">
                ¿Google Forms o <span class="text-primary">DATAUMSA?</span>
            </h2>
            <p class="text-base sm:text-lg text-text-dark-muted font-medium mt-3 max-w-xl mx-auto font-sans">
                Diferencias claras para investigación académica rigurosa.
            </p>
        </div>

        <!-- Tabla bento comparativa -->
        <div class="w-full overflow-x-auto rounded-card border-[2.5px] border-ink bg-midnight-surface">
            <div class="min-w-190 w-full">
                <!-- Cabecera de la tabla -->
                <div class="grid grid-cols-12 border-b-2 border-ink px-8 py-5 items-center bg-midnight font-mono text-xs uppercase tracking-wider">
                    <div class="col-span-4 text-text-dark-muted font-bold">
                        Característica
                    </div>
                    <div class="col-span-4 pl-6 text-text-dark-muted flex items-center gap-2 font-bold">
                        <span class="w-2 h-2 rounded-full bg-danger"></span>{" "}
                        Google Forms
                    </div>
                    <div class="col-span-4 pl-6 border-l-2 border-ink bg-primary/10 py-3 -my-3 text-primary flex items-center gap-2 font-bold">
                        <span class="w-2 h-2 rounded-full bg-primary"></span>{" "}
                        DATAUMSA
                    </div>
                </div>

                <!-- Filas comparativas -->
                <div class="divide-y-2 divide-ink">
                    {comparativeData.map((row) => (
                        <div class="grid grid-cols-12 px-8 py-5 items-center hover:bg-border-dark transition-colors duration-150">
                            <!-- Característica -->
                            <div class="col-span-4 pr-4">
                                <span class="font-display font-bold text-white text-base">
                                    {row.feature}
                                </span>
                            </div>

                            <!-- Google Forms -->
                            <div class="col-span-4 pl-6 flex items-center gap-3 text-sm font-medium text-text-dark-muted font-sans">
                                <div class="w-6 h-6 rounded-full border border-ink bg-danger/20 text-danger flex items-center justify-center shrink-0">
                                    <FiX
                                        className="w-3.5 h-3.5"
                                        strokeWidth={3}
                                    />
                                </div>
                                <span>{row.google.text}</span>
                            </div>

                            <!-- DATAUMSA -->
                            <div class="col-span-4 pl-6 border-l-2 border-ink bg-primary/5 py-3 -my-3 flex items-center gap-3 text-sm font-bold text-white font-sans">
                                <div class="w-6 h-6 rounded-full border border-ink bg-success text-ink flex items-center justify-center shrink-0">
                                    <FiCheck
                                        className="w-3.5 h-3.5"
                                        strokeWidth={3.5}
                                    />
                                </div>
                                <span>{row.umsa.text}</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>

        <!-- Cita final -->
        <div class="mt-12 text-center">
            <p class="text-text-dark-muted text-base sm:text-lg font-medium font-sans">
                “Elige la herramienta diseñada para{" "}
                <span class="text-white font-bold bg-midnight-surface px-2 py-0.5 rounded border border-primary">
                    investigación científica real
                </span>
                .”
            </p>
        </div>
    </div>
</section>
