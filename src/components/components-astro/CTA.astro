---
// Componente CTA Final para DATAUMSA (Adaptado a Bento DESIGN2.md)
import Button from "./Button.astro";
---

<div class="max-w-300 w-full mx-auto py-12 px-4 sm:px-6">
    <div class="bg-midnight-surface rounded-[2.5rem] p-8 md:p-14 relative overflow-hidden flex flex-col items-center text-center border-3 border-ink">
        {/* Grilla geométrica sutil en lugar de blobs borrosos */}
        <div
            class="absolute inset-0 opacity-[0.03] pointer-events-none"
            style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"
        ></div>

        <div class="relative z-10 max-w-2xl space-y-5">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] text-white leading-tight font-display">
                ¿Listo para empezar con{" "}
                <span class="text-primary">DATAUMSA?</span>
            </h2>

            <p class="text-base sm:text-lg text-text-dark-muted leading-relaxed max-w-xl mx-auto font-sans font-medium">
                Únete a la plataforma oficial diseñada por y para la comunidad
                universitaria. Potencia tu recolección de datos e investigación
                de forma soberana y profesional.
            </p>
        </div>

        <div class="relative z-10 flex flex-col sm:flex-row items-center justify-center gap-3.5 mt-8 w-full sm:w-auto">
            <Button
                href="https://app-dataumsa.sociest.org/accounts/login/"
                variant="bento-primary"
                target="_blank"
            >
                Acceso Institucional UMSA
            </Button>
            <Button href="/app-movil/descargas" variant="bento-secondary">
                Descargar App APK
            </Button>
            <Button
                href="/docs"
                variant="ghost"
                class="text-white hover:bg-white/10 border-white/40 hover:border-white"
            >
                Guías y Docs
            </Button>
        </div>
    </div>
</div>
