---
// BentoPageFrame.astro — Adaptación Bento para la Documentación DATAUMSA
const currentYear = new Date().getFullYear();
---

<div class="page sl-flex">
    <header class="header">
        <slot name="header" />
    </header>
    <div class="page-scroll-wrap">
        <main class="main-frame">
            <slot />
        </main>

        <!-- Footer Bento Oficial DATAUMSA -->
        <footer class="bento-docs-footer">
            <div class="bento-footer-inner">
                <div class="bento-footer-grid">
                    <!-- Columna 1: Branding -->
                    <div class="bento-footer-brand">
                        <a href="/" class="bento-footer-brand-link">
                            <img
                                src="/logo_dataumsa.png"
                                alt="Logo DATAUMSA"
                                width="180"
                                height="36"
                                class="bento-footer-logo"
                            />
                        </a>
                        <p class="bento-footer-desc">
                            Plataforma institucional de recolección y análisis
                            científico de datos de la Universidad Mayor de San
                            Andrés.
                        </p>
                        <div class="bento-footer-tag">
                            SOBERANÍA TECNOLÓGICA
                        </div>
                    </div>

                    <!-- Columna 2: Navegación -->
                    <div class="bento-footer-links-col">
                        <h4 class="bento-footer-title">Plataforma</h4>
                        <ul class="bento-footer-links">
                            <li>
                                <a href="/">Inicio</a>
                            </li>
                            <li>
                                <a href="/la-plataforma/caracteristicas/">
                                    Características
                                </a>
                            </li>
                            <li>
                                <a href="/la-plataforma/casos-de-uso/">
                                    Casos de Uso
                                </a>
                            </li>
                            <li>
                                <a href="/app-movil/descargas/">
                                    App Móvil Collect
                                </a>
                            </li>
                            <li>
                                <a
                                    href="https://app-dataumsa.sociest.org/accounts/login/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="bento-ext-link"
                                >
                                    Acceso Web
                                    <svg
                                        width="12"
                                        height="12"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <circle cx="12" cy="12" r="10" />
                                        <polyline points="10 9 15 9 15 14" />
                                        <line x1="9" y1="15" x2="15" y2="9" />
                                    </svg>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Columna 3: Documentación -->
                    <div class="bento-footer-links-col">
                        <h4 class="bento-footer-title">Guías Rápidas</h4>
                        <ul class="bento-footer-links">
                            <li>
                                <a href="/docs/guides/empezando/">
                                    Primeros Pasos
                                </a>
                            </li>
                            <li>
                                <a href="/docs/guides/inicio-rapido/">
                                    Inicio en 5 Pasos
                                </a>
                            </li>
                            <li>
                                <a href="/docs/reference/xlsform/">
                                    Referencia XLSForm
                                </a>
                            </li>
                            <li>
                                <a href="/docs/faq/">Preguntas Frecuentes</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Columna 4: Institucional -->
                    <div class="bento-footer-links-col">
                        <h4 class="bento-footer-title">Institucional</h4>
                        <ul class="bento-footer-links">
                            <li>
                                <a href="/sobre-dataumsa/historia/">
                                    Historia del Proyecto
                                </a>
                            </li>
                            <li>
                                <a href="/sobre-dataumsa/equipo-institucional/">
                                    Equipo de Investigación
                                </a>
                            </li>
                            <li>
                                <a href="/terminos/">Términos de Servicio</a>
                            </li>
                            <li>
                                <a href="/privacidad/">
                                    Políticas de Privacidad
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Línea inferior de copyright -->
                <div class="bento-footer-bottom">
                    <p class="bento-footer-copy">
                        &copy; {currentYear} <strong>DATAUMSA</strong> Todos los
                        derechos reservados.
                    </p>
                </div>
            </div>
        </footer>
    </div>
</div>

<style>
    /* Layout general del frame */
    .page {
        height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background-color: var(--sl-color-bg, var(--color-canvas));
    }

    .page-scroll-wrap {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    .main-frame {
        flex: 1 0 auto;
    }

    /* Estilos del Footer Bento */
    .bento-docs-footer {
        position: relative;
        z-index: 50;
        background-color: var(--color-midnight);
        border-top: var(--ink-border-width, 2.5px) solid var(--color-ink);
        color: var(--color-canvas);
        padding: 3.5rem 1.5rem 2rem;
        margin-top: 4rem;
        width: 100%;
        box-sizing: border-box;
    }

    .bento-footer-inner {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .bento-footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 2.5rem;
    }

    @media (max-width: 900px) {
        .bento-footer-grid {
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }
    }

    @media (max-width: 600px) {
        .bento-footer-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    .bento-footer-brand {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .bento-footer-logo {
        height: 38px;
        width: auto;
        object-fit: contain;
    }

    .bento-footer-desc {
        color: var(--color-text-dark-muted);
        font-size: 0.875rem;
        line-height: 1.6;
        max-width: 320px;
        margin: 0;
    }

    .bento-footer-tag {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        padding: 4px 10px;
        background-color: var(--color-midnight-surface);
        border: 1.5px solid var(--color-primary);
        border-radius: var(--radius-pill, 9999px);
        color: var(--color-primary);
        font-family: var(--font-mono, monospace);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    .bento-footer-title {
        font-family: var(--font-display, "Montserrat", sans-serif);
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--color-white-plate);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 1rem;
    }

    .bento-footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .bento-footer-links a {
        color: var(--color-text-dark-muted);
        font-size: 0.875rem;
        text-decoration: none;
        transition:
            color 0.15s ease,
            transform 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .bento-footer-links a:hover {
        color: var(--color-primary);
        transform: translateX(2px);
    }

    .bento-footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--color-border-dark);
        padding-top: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .bento-footer-copy {
        color: var(--color-text-muted);
        font-size: 0.8125rem;
        margin: 0;
    }

    .bento-footer-copy strong {
        color: #e2e8f0;
    }

    .bento-footer-pills {
        display: flex;
        gap: 0.5rem;
    }

    .bento-pill-item {
        font-family: var(--font-mono, monospace);
        font-size: 0.75rem;
        color: var(--color-text-dark-muted);
        background: var(--color-midnight-surface);
        padding: 2px 8px;
        border-radius: 6px;
        border: 1px solid var(--color-border-dark);
    }
</style>
